end

Shapes["Arc Discharge"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU
    local arc = sin(frac*math.pi)*r
    local zap = sin(t*sp*8 + i*2.1)*r*0.15
    return Vector3.new(cos(a)*r + zap, h + arc + zap, sin(a)*r + zap)
end

Shapes["Event Horizon"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU*5 + t*sp
    local dist = r*(0.2 + 0.8*abs(sin(frac*math.pi)))
    local warp = sin(t*sp*3 + frac*TAU)*r*0.1
    return Vector3.new(cos(a)*dist, h + warp, sin(a)*dist)
end

Shapes.Butterfly = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp*0.5
    local ex = math.exp(cos(a)) - 2*cos(4*a) - sin(a/12)^5
    local rr = ex*r*0.4
    return Vector3.new(cos(a)*rr, h + sin(t*sp + i*0.1)*1.5, sin(a)*rr)
end

Shapes["Rose Petal"] = function(i, n, t, r, h, sp)
    local k = 5
    local a = (i/n)*TAU + t*sp*0.3
    local rr = r*cos(k*a)
    return Vector3.new(cos(a)*rr, h + sin(t*sp + i*0.2)*2, sin(a)*rr)
end

Shapes.Snowflake = function(i, n, t, r, h, sp)
    local arm = i % 6
    local slice = math.max(math.floor(n/6), 1)
    local frac = (i % slice)/slice
    local baseA = arm*(TAU/6) + t*sp*0.2
    local dist = frac*r
    local branch = sin(frac*math.pi*4)*r*0.2
    return Vector3.new(cos(baseA)*dist + cos(baseA + math.pi/2)*branch, h + cos(t*sp)*0.5, sin(baseA)*dist + sin(baseA + math.pi/2)*branch)
end

Shapes["Crystal Bloom"] = function(i, n, t, r, h, sp)
    local petals = 8
    local arm = i % petals
    local slice = math.max(math.floor(n/petals), 1)
    local frac = (i % slice)/slice
    local baseA = arm*(TAU/petals) + t*sp*0.3
    local dist = frac*r
    local lift = sin(frac*math.pi)*r*0.5
    return Vector3.new(cos(baseA)*dist, h + lift, sin(baseA)*dist)
end

Shapes["Vine Wrap"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local turns = 4
    local a = frac*TAU*turns + t*sp
    local y = frac*r*2 - r
    local bulge = 1 + 0.3*sin(frac*TAU*turns*2)
    local rr = r*0.5*bulge
    return Vector3.new(cos(a)*rr, h + y, sin(a)*rr)
end

Shapes["Flower Bloom"] = function(i, n, t, r, h, sp)
    local petals = 6
    local a = (i/n)*TAU + t*sp*0.4
    local rr = r*abs(cos(petals*a*0.5))
    local bloom = 1 + 0.2*sin(t*sp*2)
    return Vector3.new(cos(a)*rr*bloom, h + sin(t*sp + a)*1.5, sin(a)*rr*bloom)
end

Shapes.Jellyfish = function(i, n, t, r, h, sp)
    local bell = math.floor(n*0.4)
    if i <= bell then
        local phi = (i/bell)*math.pi*0.5
        local theta = (i/bell)*TAU + t*sp
        local pulse = r*(1 + 0.2*sin(t*sp*3))
        return Vector3.new(cos(theta)*sin(phi)*pulse, cos(phi)*pulse*0.5 + h, sin(theta)*sin(phi)*pulse)
    else
        local idx = i - bell
        local c = n - bell
        local a = (idx/c)*TAU + t*sp
        local drop = (idx/c)*r*1.5
        local wave = sin(t*sp*4 + a*3)*r*0.15
        return Vector3.new(cos(a)*r*0.2 + wave, h - drop, sin(a)*r*0.2 + wave)
    end
end

Shapes["Coral Reef"] = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp*0.2
    local frac = i/n
    local y = sin(frac*TAU*3 + t*sp)*r*0.8
    local rr = r*(0.5 + 0.5*sin(frac*TAU*5))
    local sway = sin(t*sp + frac*12)*r*0.1
    return Vector3.new(cos(a)*rr + sway, h + y, sin(a)*rr + sway)
end

Shapes["Volcano Burst"] = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local burst = abs(sin(t*sp + i))*r*2
    return Vector3.new(cos(a)*burst, h + burst, sin(a)*burst)
end

Shapes["Cosmic Explosion"] = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local wave = abs(sin(t*sp*2 - i*0.1))
    return Vector3.new(cos(a)*r*wave*3, h + wave*5, sin(a)*r*wave*3)
end

Shapes.Supernova = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5)) + t*sp
    local blast = r*(1 + sin(t*sp*0.5)*0.5)
    local eject = sin(phi*3 + t*sp*4)*r*0.3
    local R = blast + eject
    return Vector3.new(cos(theta)*sin(phi)*R, cos(phi)*R + h, sin(theta)*sin(phi)*R)
end

Shapes["Firework Pop"] = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5))
    local trail = abs(sin(t*sp*3 + i*0.7))
    local rr = r*trail
    local sparkle = sin(t*sp*10 + i)*0.8
    return Vector3.new(cos(theta)*sin(phi)*rr, cos(phi)*rr + h + sparkle, sin(theta)*sin(phi)*rr)
end

Shapes.Shockwave = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local ring = sin(t*sp*3)*r
    local y = cos(t*sp*2 + i*0.2)*r*0.3
    return Vector3.new(cos(a)*ring, h + y, sin(a)*ring)
end

Shapes.Lissajous = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local p, q = 3, 2
    local d = math.pi/2
    return Vector3.new(r*sin(p*a + d), h + r*0.4*sin(t*sp + i*0.1), r*sin(q*a))
end

Shapes.Hypotrochoid = function(i, n, t, r, h, sp)
    local R, rd, d = r, r*0.4, r*0.7
    local a = (i/n)*TAU + t*sp
    local x = (R - rd)*cos(a) + d*cos((R - rd)/rd*a)
    local z = (R - rd)*sin(a) - d*sin((R - rd)/rd*a)
    return Vector3.new(x*0.7, h + sin(t*sp + i*0.2)*2, z*0.7)
end

Shapes.Epitrochoid = function(i, n, t, r, h, sp)
    local R, rd, d = r*0.6, r*0.35, r*0.5
    local a = (i/n)*TAU + t*sp
    local x = (R + rd)*cos(a) - d*cos((R + rd)/rd*a)
    local z = (R + rd)*sin(a) - d*sin((R + rd)/rd*a)
    return Vector3.new(x*0.7, h + sin(t*sp + i*0.15)*2, z*0.7)
end

Shapes.Trefoil = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local x = sin(a) + 2*sin(2*a)
    local y = cos(a) - 2*cos(2*a)
    local z = -sin(3*a)
    local sc = r/3
    return Vector3.new(x*sc, y*sc + h, z*sc)
end

Shapes.Harmonograph = function(i, n, t, r, h, sp)
    local frac = i/n
    local decay = math.exp(-frac*0.5)
    local f1, f2, f3, f4 = 3, 2, 3, 2
    local p1, p2 = math.pi/4, math.pi/6
    local a = frac*TAU*8 + t*sp
    local x = r*decay*(sin(f1*a + p1) + sin(f2*a))
    local z = r*decay*(sin(f3*a + p2) + sin(f4*a))
    return Vector3.new(x*0.5, h + sin(t*sp + frac*12)*1.5, z*0.5)
end

Shapes["Spiral Staircase"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU*3 + t*sp
    local y = frac*r*2 - r
    local step = math.floor(frac*12)/12
    return Vector3.new(cos(a)*r*0.6, h + y + step*0.2, sin(a)*r*0.6)
end

Shapes["Chain Link"] = function(i, n, t, r, h, sp)
    local link = math.floor(i/3)
    local sub = i % 3
    local baseA = (link/math.max(n/3,1))*TAU + t*sp
    if sub == 0 then
        return Vector3.new(cos(baseA)*r, h + sin(baseA)*r*0.4, sin(baseA)*r*0.4)
    elseif sub == 1 then
        return Vector3.new(cos(baseA+0.3)*r, h + sin(baseA+0.3)*r*0.4, sin(baseA+0.3)*r*0.4)
    else
        return Vector3.new(cos(baseA-0.3)*r, h + sin(baseA-0.3)*r*0.4, sin(baseA-0.3)*r*0.4)
    end
end

Shapes["Ribbon Twist"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU + t*sp
    local twist = frac*TAU*3
    local w = r*0.3
    return Vector3.new((r + w*cos(twist))*cos(a), h + w*sin(twist)*2, (r + w*cos(twist))*sin(a))
end

Shapes["Diamond Cage"] = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5)) + t*sp
    local diamond = abs(sin(theta*2))*0.3 + 0.85
    return Vector3.new(cos(theta)*sin(phi)*r*diamond, cos(phi)*r*diamond + h, sin(theta)*sin(phi)*r*diamond)
end

Shapes["Pendulum Wave"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU + t*sp
    local swing = sin(t*sp*2 + frac*math.pi*2)
    return Vector3.new(cos(a)*r*0.8, h + swing*r*0.5, sin(a)*r*0.8)
end

Shapes["Pyramid Stack"] = function(i, n, t, r, h, sp)
    local layer = math.floor((1 - math.sqrt(1 - i/n)) * 6)
    local layerStart = math.floor((1 - (1 - layer/6)^2) * n)
    local inLayer = i - layerStart
    local layerCount = math.max(math.floor((1 - (1 - (layer+1)/6)^2) * n) - layerStart, 1)
    local a = (inLayer/layerCount)*TAU + t*sp
    local rad = r * (1 - layer/6)
    return Vector3.new(cos(a)*rad, h + layer*r*0.35, sin(a)*rad)
end

Shapes["Hex Grid"] = function(i, n, t, r, h, sp)
    local cols = math.ceil(math.sqrt(n))
    local row = math.floor(i/cols)
    local col = i % cols
    local stagger = (row % 2 == 0) and 0 or 0.5
    local sx = r*2/cols
    local sy = sx*sqrt(3)/2
    local wave = sin(t*sp*2 + (row+col)*0.5)*0.4
    return Vector3.new((col - cols/2 + stagger)*sx, h + wave, (row - cols/2)*sy)
end

Shapes["Bird Flock"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU + t*sp*0.5
    local wave = sin(t*sp*1.2 + frac*TAU*3)
    local rad = r*(0.5 + 0.5*wave)
    return Vector3.new(cos(a)*rad, h + sin(t*sp + frac*8)*r*0.3, sin(a)*rad)
end

Shapes["Moon Orbit"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU + t*sp
    local phase = frac*TAU*8
    local wobble = sin(t*sp*2 + phase)*r*0.15
    return Vector3.new(cos(a)*(r + wobble), h + sin(phase)*r*0.4, sin(a)*(r + wobble))
end

Shapes["Fire Ring"] = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local flicker = sin(t*sp*10 + i*1.3)*0.5 + 0.5
    local rr = r*(0.8 + flicker*0.4)
    return Vector3.new(cos(a)*rr, h + flicker*r*0.3, sin(a)*rr)
end

Shapes["Ghost Trail"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU + t*sp
    local ghost = math.exp(-frac*1.5)
    local y = sin(t*sp*2 - frac*6)*r*0.5
    return Vector3.new(cos(a)*r*ghost*1.5, h + y, sin(a)*r*ghost*1.5)
end

Shapes["Runic Circle"] = function(i, n, t, r, h, sp)
    local ring = i % 3
    local frac = i/n
    local radius = r*(0.6 + ring*0.25)
    local a = frac*TAU + t*sp*(ring+1)*0.5
    local pulse = sin(t*sp*3 + ring*2)*0.3
    return Vector3.new(cos(a)*radius, h + pulse, sin(a)*radius)
end

Shapes["Aurora Wave"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local x = (frac - 0.5) * r * 2
    local y = sin(t*sp + frac*TAU*2)*r*0.3
    local z = cos(t*sp*0.7 + frac*TAU*3)*r*0.5
    return Vector3.new(x, h + y, z)
end

Shapes["Burst Firework"] = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5))
    local cycle = (t*sp) % 3
    local radius = cycle < 1 and cycle*r or (cycle < 2 and (3-cycle)*r or 0)
    return Vector3.new(cos(theta)*sin(phi)*radius, cos(phi)*radius + h, sin(theta)*sin(phi)*radius)
end

Shapes["Glitter Bomb"] = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5))
    local jitter = sin(t*sp*8 + i*3)*r*0.15
    local rr = r + jitter
    return Vector3.new(cos(theta)*sin(phi)*rr, cos(phi)*rr + h, sin(theta)*sin(phi)*rr)
end

Shapes["Warp Tunnel"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local ring = math.floor(frac*10)/10
    local slice = math.max(math.floor(n/10),1)
    local a = ((i % slice)/slice)*TAU + t*sp*(1+ring)
    local z = (frac - 0.5)*r*4
    local radius = r*0.6*(1 + 0.3*sin(t*sp*3 + ring*10))
    return Vector3.new(cos(a)*radius, h + sin(a)*radius, z)
end

Shapes["Time Vortex"] = function(i, n, t, r, h, sp)
    local frac = i/n
    local a = frac*TAU*4 + t*sp*2
    local dist = r*math.exp(-frac*2)*2
    local y = (frac-0.5)*r*2
    return Vector3.new(cos(a)*dist, h + y, sin(a)*dist)
end

Shapes["Thunder Cage"] = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5))
    local bolt = sin(theta*8 + t*sp*6)*r*0.2
    local rr = r + bolt
    return Vector3.new(cos(theta)*sin(phi)*rr, cos(phi)*rr + h, sin(theta)*sin(phi)*rr)
end

Shapes["Pixel Sphere"] = function(i, n, t, r, h, sp)
    local phi = math.acos(1 - 2*(i/n))
    local theta = i*math.pi*(3 - sqrt(5))
    local px = math.floor(cos(theta)*sin(phi)*8)/8
    local py = math.floor(cos(phi)*8)/8
    local pz = math.floor(sin(theta)*sin(phi)*8)/8
    return Vector3.new(px*r, py*r + h, pz*r)
end

Shapes["Kaleidoscope"] = function(i, n, t, r, h, sp)
    local a = (i/n)*TAU + t*sp
    local k = 8
    local mirror = abs(((a*k) % TAU) - math.pi) / math.pi
    local rr = r*mirror
    return Vector3.new(cos(a)*rr, h + sin(t*sp*2 + i*0.1)*1.5, sin(a)*rr)
end

