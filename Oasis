function TBringTarget(target)
    if not target or not target.Character then return end
    local targetHead = target.Character:FindFirstChild("Head")
    local myRoot = getHumanoidRootPart()
    if not (targetHead and myRoot) then return end

    local oldCFrame = myRoot.CFrame
    for _ = 1, 2 do
        if not targetHead.Parent then break end
        myRoot.CFrame = targetHead.CFrame * CFrame.new(2, 0, 0)
        pcall(function()
            ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(targetHead, myRoot.CFrame)
        end)
        task.wait(0.15)
    end

    myRoot.CFrame = oldCFrame
    local front = oldCFrame.LookVector * 5
    pcall(function()
        targetHead.CFrame = CFrame.new(oldCFrame.Position + front)
        ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(targetHead)
    end)
end


