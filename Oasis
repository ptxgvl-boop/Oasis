function startOATSKick(target)
    if not target or not target.Parent then return end
    if OATSKickActive then return end
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local RS = game:GetService("ReplicatedStorage")
    local LP = Players.LocalPlayer

    OATSKickActive = true

    OATSKickTask = task.spawn(function()
        local GE = RS:WaitForChild("GrabEvents")
        local SetNetOwner = GE:WaitForChild("SetNetworkOwner")
        local DestroyGrabLine = GE:WaitForChild("DestroyGrabLine")

        local ZERO_VECTOR = Vector3.new(0, 0, 0)
        local GRAB_TIMEOUT = 0.15
        local MAX_DISTANCE = 29
        local HIDDEN_CF = CFrame.new(0, 1e9, 0)

        local targetName = target.Name
        local isGrabbing = false
        local startTime = nil
        local checkStartTime = nil
        local currentTargetRoot = nil
        local attachments = {}
        local cam = workspace.CurrentCamera
        local oldCamType = cam.CameraType
        local oldCamSubject = cam.CameraSubject
        local lastPalletTime = 0

        local function cleanupPhysicsObjects()
            isGrabbing        = false
            currentTargetRoot = nil
            for _, v in pairs(attachments) do
                if v then pcall(function() v:Destroy() end) end
            end
            attachments = {}
            cam.CameraType = oldCamType
            cam.CameraSubject = oldCamSubject
        end

        local function isTargetAlive()
            target = Players:FindFirstChild(targetName)
            if not target or not target.Parent then return false end
            local char = target.Character
            if not char then return false end
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or hum.Health <= 0 or not root then return false end
            currentTargetRoot = root
            return true
        end

        local function snoLocal(part)
            pcall(function()
                if SetNetOwner then
                    SetNetOwner:FireServer(part, part.CFrame)
                end
            end)
        end

        -- Shared pallet spawn
        local MyToys = Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
        local pallet = MyToys and MyToys:FindFirstChild("PalletLightBrown")
        if not pallet and LP.CanSpawnToy.Value then
            pcall(function()
                RS.MenuToys.SpawnToyRemoteFunction:InvokeServer("PalletLightBrown", HIDDEN_CF, Vector3.new(0, -90, 0))
            end)
            task.wait(0.5)
            MyToys = Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
            pallet = MyToys and MyToys:FindFirstChild("PalletLightBrown")
        end
        local soundPart = pallet and pallet:FindFirstChild("SoundPart")
        if not soundPart then
            OATSKickActive = false
            return
        end

        local myChar = LP.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            OATSKickActive = false
            return
        end
        local savedPos = myRoot.CFrame

        -- Ownership spam loop
        task.spawn(function()
            while OATSKickActive do
                if target and target.Parent and target.Character then
                    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot then
                        snoLocal(tRoot)
                        DestroyGrabLine:FireServer(tRoot)
                        tRoot.AssemblyLinearVelocity = ZERO_VECTOR
                        tRoot.AssemblyAngularVelocity = ZERO_VECTOR
                    end
                end
                task.wait(0.011)
            end
        end)

        -- Main loop
        while OATSKickActive do
            task.wait(0.0010416666666667)

            if not isTargetAlive() then
                cleanupPhysicsObjects()
                task.wait(0.5)
                continue
            end

            myChar = LP.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then continue end
            local tChar = target.Character
            local tHum = tChar and tChar:FindFirstChild("Humanoid")
            local tRoot = currentTargetRoot

            if tRoot then
                pcall(function()
                    snoLocal(tRoot)
                    RunService.Stepped:Wait(0)
                    DestroyGrabLine:FireServer(tRoot)
                end)
                local limbs = { "Left Leg", "Right Leg", "Left Arm", "Right Arm", "Head", "Torso", "UpperTorso", "LowerTorso" }
                for _, limbName in ipairs(limbs) do
                    local part = tChar:FindFirstChild(limbName)
                    if part then
                        part.Velocity    = ZERO_VECTOR
                        part.RotVelocity = ZERO_VECTOR
                        part.CanCollide  = false
                    end
                end
            end

            local vel = tRoot.AssemblyLinearVelocity
            local predictionTime = 0.1
            local predictedPos = tRoot.Position + vel * predictionTime

            if not isGrabbing then
                local predictedCF = CFrame.new(predictedPos) * (tRoot.CFrame - tRoot.Position)
                myRoot.CFrame = predictedCF * CFrame.new(0, -6, -10)
                myRoot.Velocity = ZERO_VECTOR
                tHum.PlatformStand = true
                tHum.Sit = false

                if not startTime then startTime = tick() end

                if tick() - startTime > GRAB_TIMEOUT then
                    cam.CameraType = Enum.CameraType.Scriptable
                    cam.CFrame = cam.CFrame

                    isGrabbing = true
                    startTime = nil
                    myRoot.CFrame = savedPos
                    myRoot.Velocity = ZERO_VECTOR

                    local att0 = Instance.new("Attachment", tRoot)
                    local att1 = Instance.new("Attachment", myRoot)
                    att1.CFrame = CFrame.new(0, 12, 0)

                    local ap = Instance.new("AlignPosition", tRoot)
                    ap.Attachment0 = att0
                    ap.Attachment1 = att1
                    ap.MaxForce = math.huge
                    ap.MaxVelocity = math.huge
                    ap.Responsiveness = 400
                    ap.ApplyAtCenterOfMass = true

                    local ao = Instance.new("AlignOrientation", tRoot)
                    ao.Attachment0 = att0
                    ao.Attachment1 = att1
                    ao.MaxTorque = math.huge
                    ao.Responsiveness = 400

                    attachments.att0 = att0
                    attachments.att1 = att1
                    attachments.ap = ap
                    attachments.ao = ao
                    tHum:ChangeState(Enum.HumanoidStateType.Physics)

                    cam.CameraType = oldCamType
                    cam.CameraSubject = oldCamSubject
                end
            else
                if attachments.att1 then
                    attachments.att1.CFrame = CFrame.new(oatsetX, oatsetY, oatsetZ)
                end

                if not checkStartTime then checkStartTime = tick() + 0.25 end
                if checkStartTime and tick() >= checkStartTime then
                    local dist = (myRoot.Position - tRoot.Position).Magnitude
                    if dist > MAX_DISTANCE then
                        cleanupPhysicsObjects()
                        isGrabbing = false
                        startTime = tick()
                        checkStartTime = nil
                        savedPos = myRoot.CFrame
                        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, -8, 0)
                        myRoot.Velocity = ZERO_VECTOR
                        pcall(function()
                            snoLocal(tRoot)
                            DestroyGrabLine:FireServer(tRoot)
                        end)
                        continue
                    end
                end

                pcall(function()
                    snoLocal(tRoot)
                    DestroyGrabLine:FireServer(tRoot)
                end)

                local currentTime = tick()
                if currentTime - lastPalletTime >= 0.01 then
                    lastPalletTime = currentTime
                    soundPart.CFrame = tRoot.CFrame * CFrame.new(0, 2, 0)
                    pcall(function()
                        snoLocal(soundPart)
                    end)
                    task.wait()
                    soundPart.CFrame = HIDDEN_CF
                end
            end
        end

        cleanupPhysicsObjects()
        if myRoot and savedPos then myRoot.CFrame = savedPos end
    end)
end

function stopOATSKick(target)
    OATSKickActive = false
    if OATSKickTask then
        pcall(function() task.cancel(OATSKickTask) end)
        OATSKickTask = nil
    end
    if target then cleanupOATSKick(target) end
end

function cleanupOATSKick(target)
    if target and target.Character then
        local tH = target.Character:FindFirstChild("HumanoidRootPart")
        if tH then
            local align = tH:FindFirstChild("AlignPosition")
            local rot   = tH:FindFirstChild("AlignOrientation")
            local att0  = tH:FindFirstChild("KickAtt0")
            local att1  = workspace.Terrain:FindFirstChild("KickAtt1")

            if align then
                if align.Attachment1 then align.Attachment1:Destroy() end
                align:Destroy()
            end
            if rot then rot:Destroy() end
            if att0 then att0:Destroy() end
            if att1 then att1:Destroy() end

            pcall(function()
                game:GetService("ReplicatedStorage").GrabEvents.DestroyGrabLine:FireServer(tH)
            end)
        end
    end
end


