function isSittingOnBlobman()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return false end
    local seat = hum.SeatPart
    if not seat then return false end
    if seat.Parent and seat.Parent.Name == "CreatureBlobman" then
        return true, seat.Parent
    end
    return false
end

function blobServerKickOne(plr)
    if not plr or not plr.Parent or not plr.Character then return false end

    local ok, blob = isSittingOnBlobman()
    if not ok then return false end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local tChar = plr.Character
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChild("Humanoid")
    local tHead = tChar:FindFirstChild("Head")
    if not (tRoot and tHum and tHead) or tHum.Health <= 0 then return false end

    local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
    if not GE then return false end

    local SetNetOwner = GE:FindFirstChild("SetNetworkOwner")
    local CreateLine = GE:FindFirstChild("CreateGrabLine")
    local DestroyLine = GE:FindFirstChild("DestroyGrabLine")

    local rightDet = blob:FindFirstChild("RightDetector")
    local rightWeld = rightDet and rightDet:FindFirstChild("RightWeld")
    local leftDet = blob:FindFirstChild("LeftDetector")
    local leftWeld = leftDet and leftDet:FindFirstChild("LeftWeld")
    local blobScript = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    local CreatureGrab = blobScript and blobScript:FindFirstChild("CreatureGrab")
    local CreatureRelease = blobScript and blobScript:FindFirstChild("CreatureRelease")

    if not (rightDet and rightWeld and CreatureGrab and CreatureRelease) then return false end

    local savedPos = myRoot.CFrame

    pcall(function()
        myRoot.CFrame = tRoot.CFrame + Vector3.new(0, 2, 4)
        if SetNetOwner then SetNetOwner:FireServer(tRoot, tRoot.CFrame) end
        task.wait(0.05)
        if DestroyLine then DestroyLine:FireServer(tRoot) end
        task.wait(0.05)

        if tHead:FindFirstChild("PartOwner") and tHead.PartOwner.Value == LocalPlayer.Name then
            tHum.PlatformStand = true
            if CreateLine then CreateLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
            CreatureGrab:FireServer(rightDet, tRoot, rightWeld)
            task.wait(0.05)
            CreatureRelease:FireServer(rightWeld, tRoot)
            task.wait(0.05)
            tRoot.AssemblyLinearVelocity = Vector3.new(0, 9999999, 0)
            if DestroyLine then DestroyLine:FireServer(tRoot) end
        end

        myRoot.CFrame = savedPos
    end)

    return true
end

function startBlobServerLoop()
    if BlobServerLoopActive then return end
    BlobServerLoopActive = true

    BlobServerLoopTask = task.spawn(function()
        while BlobServerLoopActive do
            local ok = isSittingOnBlobman()
            if not ok then
                task.wait(0.5)
                continue
            end

            local players = getBlobServerPlayers()

            for _, plr in ipairs(players) do
                if not BlobServerLoopActive then break end
                if not plr or not plr.Parent or not plr.Character then continue end

                blobServerKickOne(plr)

                if plr and plr.UserId then
                    BlobKickedPlayers[plr.UserId] = true
                end

                task.wait(0.1)
            end

            task.wait(0.5)
        end
    end)
end

function stopBlobServerLoop()
    BlobServerLoopActive = false
    if BlobServerLoopTask then
        pcall(function() task.cancel(BlobServerLoopTask) end)
        BlobServerLoopTask = nil
    end
end

