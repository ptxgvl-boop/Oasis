function getBlobServerPlayers()
    local players = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local alreadyKicked = BlobKickedPlayers[plr.UserId] == true
            local whitelisted = _G.isWhitelisted and _G.isWhitelisted(plr)
