AntiCrash = {}

Players    = game:GetService("Players")
Workspace  = game:GetService("Workspace")

LocalPlayer = Players.LocalPlayer

AntiCrash.Enabled = false
AntiCrash.Connections = {}

function AntiCrash.hookCharacter(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local conn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if not AntiCrash.Enabled then return end
        if hum.Health == 0 then
            pcall(function() char:Destroy() end)
        end
    end)
    table.insert(AntiCrash.Connections, conn)
end

function AntiCrash.start()
    if AntiCrash.Enabled then return end
    AntiCrash.Enabled = true

    local childConn = Workspace.ChildAdded:Connect(function(child)
        if not AntiCrash.Enabled then return end

        local plr = Players:GetPlayerFromCharacter(child)
        if not plr or plr == LocalPlayer then return end

        task.defer(function()
            AntiCrash.hookCharacter(child)
        end)
    end)
    table.insert(AntiCrash.Connections, childConn)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            AntiCrash.hookCharacter(plr.Character)
        end
    end

    local plrAddedConn = Players.PlayerAdded:Connect(function(plr)
        if not AntiCrash.Enabled then return end
        plr.CharacterAdded:Connect(function(char)
            if not AntiCrash.Enabled then return end
            AntiCrash.hookCharacter(char)
        end)
    end)
    table.insert(AntiCrash.Connections, plrAddedConn)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            plr.CharacterAdded:Connect(function(char)
                if not AntiCrash.Enabled then return end
                AntiCrash.hookCharacter(char)
            end)
        end
    end
end

function AntiCrash.stop()
    if not AntiCrash.Enabled then return end
    AntiCrash.Enabled = false

    for _, conn in ipairs(AntiCrash.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    AntiCrash.Connections = {}
end

