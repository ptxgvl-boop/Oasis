        local removedCount = 0
        for name, _ in pairs(WhitelistUsers) do
            removedCount = removedCount + 1
        end

        WhitelistUsers = {}
        AutoWhitelistedFriends = {}

        RefreshWhitelistDropdown()

        Library:Notify({
            Title = "<b>PredatorX</b>",
            Description = "Removed " .. removedCount .. " player(s) from whitelist",
            Icon = "rbxassetid://116176143011396",
            Duration = 3
        })
    end
})

WhitelistGroup:AddCheckbox("AutoWhitelistFriends", {
    Text = "Auto Whitelist Friends",
    Default = false,
    Callback = function(Value)
        AutoWhitelistFriends = Value

        if Value then
            task.spawn(function()
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local ok, isFriend = pcall(function()
                            return LocalPlayer:IsFriendsWith(plr.UserId)
                        end)
                        if ok and isFriend and not WhitelistUsers[plr.Name] then
                            WhitelistUsers[plr.Name] = true
                            AutoWhitelistedFriends[plr.Name] = true
                            Library:Notify({
                                Title = "<b>PredatorX</b>",
                                Description = "Auto-whitelisted friend: " .. plr.DisplayName,
                                Icon = "rbxassetid://116176143011396",
                                Duration = 3
                            })
                        end
                    end
                end
                RefreshWhitelistDropdown()
            end)

            if WhitelistFriendConn then
                WhitelistFriendConn:Disconnect()
            end

            WhitelistFriendConn = Players.PlayerAdded:Connect(function(plr)
                if not AutoWhitelistFriends then return end
                if plr == LocalPlayer then return end

                task.wait(0.5)

                local ok, isFriend = pcall(function()
                    return LocalPlayer:IsFriendsWith(plr.UserId)
                end)

                if ok and isFriend and not WhitelistUsers[plr.Name] then
                    WhitelistUsers[plr.Name] = true
                    AutoWhitelistedFriends[plr.Name] = true
                    Library:Notify({
                        Title = "<b>PredatorX</b>",
                        Description = "Auto-whitelisted friend: " .. plr.DisplayName,
                        Icon = "rbxassetid://116176143011396",
                        Duration = 5
                    })
                    RefreshWhitelistDropdown()
                end
            end)
        else
            if WhitelistFriendConn then
                WhitelistFriendConn:Disconnect()
                WhitelistFriendConn = nil
            end

            local removedCount = 0
            for name, _ in pairs(AutoWhitelistedFriends) do
                if WhitelistUsers[name] then
                    WhitelistUsers[name] = nil
                    removedCount = removedCount + 1
                end
            end
            AutoWhitelistedFriends = {}

            RefreshWhitelistDropdown()

            if removedCount > 0 then
                Library:Notify({
                    Title = "<b>PredatorX</b>",
                    Description = "Removed " .. removedCount .. " auto-whitelisted friend(s)",
                    Icon = "rbxassetid://116176143011396",
                    Duration = 3
                })
            end
        end
    end
})

