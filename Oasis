 function getNearestPlayerHRP(fromHRP)
    local nearest, dist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - fromHRP.Position).Magnitude
                if d < dist then
                    dist = d
                    nearest = hrp
                end
            end
        end
    end
    return nearest
end

local function clearConnections()
    for _, conn in ipairs(DesyncConnections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    DesyncConnections = {}

    if CharacterConn then
        pcall(function() CharacterConn:Disconnect() end)
        CharacterConn = nil
    end
end

 function hookHumanoid(humanoid)
    local lastSeat = nil
    local conn = humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
        if not DesyncEnabled then return end

        local seat = humanoid.SeatPart
        if not seat then
            lastSeat = nil
            return
        end
        if seat == lastSeat then return end
        lastSeat = seat

        local blob = seat:FindFirstAncestor("CreatureBlobman")
        if not blob then return end

        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)

        local char = humanoid.Parent
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        task.defer(function()
            if not DesyncEnabled then return end

            local targetHRP = getNearestPlayerHRP(hrp)
            if targetHRP then
                hrp.CFrame = targetHRP.CFrame
            end

            for i = 1, 20 do
                if not DesyncEnabled then break end
                task.wait(0.000001)
                humanoid.Jump = true
            end
        end)
    end)

    table.insert(DesyncConnections, conn)
end

