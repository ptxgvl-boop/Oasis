function UpdateTargetInfo()
    if infoUpdateTask then
        pcall(function() task.cancel(infoUpdateTask) end)
        infoUpdateTask = nil
    end

    local count = GetSelectedCount()

    
    if count == 0 then
        if avatarImage then
            pcall(function() avatarImage:SetImage("rbxassetid://0") end)
        end
        if statusLabel then statusLabel:SetText("<b> Status: No Target </b>") end
        if distanceLabel then distanceLabel:SetText("<b> Distance: N/A </b>") end
        if aliveLabel then aliveLabel:SetText("<b> Alive: N/A </b>") end
        return
    end

  
    if count > 1 then
        if avatarImage then
            pcall(function() avatarImage:SetImage("rbxassetid://0") end)
        end

        infoUpdateTask = task.spawn(function()
            while true do
                local c = GetSelectedCount()
                if c == 0 then break end

                local aliveCount = 0
                local totalDist = 0
                local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                for plr, _ in pairs(SelectedTargets) do
                    if plr and plr.Parent then
                        local char = plr.Character
                        local hum = char and char:FindFirstChild("Humanoid")
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")

                        if hum and hum.Health > 0 then
                            aliveCount = aliveCount + 1
                        end
                        if hrp and myHRP then
                            totalDist = totalDist + (hrp.Position - myHRP.Position).Magnitude
                        end
                    end
                end

                local avgDist = c > 0 and math.floor(totalDist / c) or 0

                if statusLabel then
                    statusLabel:SetText(string.format("<b> Status: <font color='rgb(110,165,240)'>%d Players Selected</font> </b>", c))
                end
                if distanceLabel then
                    distanceLabel:SetText(string.format("<b> Avg Distance: %d studs </b>", avgDist))
                end
                if aliveLabel then
                    aliveLabel:SetText(string.format("<b> Alive: <font color='rgb(50,255,50)'>%d</font> / %d </b>", aliveCount, c))
                end

                task.wait(0.5)
            end
        end)
        return
    end

   
    local ok, avatarUrl = pcall(function()
        return Players:GetUserThumbnailAsync(SelectedTarget.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)

    if ok and avatarUrl then
        if avatarImage then
            pcall(function() avatarImage:SetImage(avatarUrl) end)
        end
    end

    infoUpdateTask = task.spawn(function()
        while true do
            if not SelectedTarget then break end

            local count = GetSelectedCount()
            if count ~= 1 then
                
                UpdateTargetInfo()
                break
            end

            if not Players:FindFirstChild(SelectedTarget.Name) then
                if avatarImage then
                    pcall(function() avatarImage:SetImage("rbxassetid://0") end)
                end
                if statusLabel then statusLabel:SetText("<b> Status: <font color='rgb(255,150,50)'>Not In Server</font> </b>") end
                if distanceLabel then distanceLabel:SetText("<b> Distance: N/A </b>") end
                if aliveLabel then aliveLabel:SetText("<b> Alive: N/A </b>") end
                break
            end

            pcall(function()
                local char = SelectedTarget.Character

                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")

                    if hum and statusLabel and aliveLabel then
                        local health = hum.Health

                        if health <= 0 then
                            statusLabel:SetText("<b> Status: In Server </b>")
                            aliveLabel:SetText("<b> Alive: <font color='rgb(255,50,50)'>No</font> </b>")
                        else
                            statusLabel:SetText("<b> Status: In Server </b>")
                            aliveLabel:SetText("<b> Alive: <font color='rgb(50,255,50)'>Yes</font> </b>")
                        end
                    end

                    if hrp and LocalPlayer.Character and distanceLabel then
                        local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myHRP then
                            local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                            distanceLabel:SetText("<b> Distance: " .. dist .. " studs </b>")
                        end
                    end
                else
                    if statusLabel then statusLabel:SetText("<b> Status: <font color='rgb(255,150,50)'>Loading...</font> </b>") end
                    if distanceLabel then distanceLabel:SetText("<b> Distance: N/A </b>") end
                    if aliveLabel then aliveLabel:SetText("<b> Alive: N/A </b>") end
                end
            end)

            task.wait(0.5)
        end
    end)
end
