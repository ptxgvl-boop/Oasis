    RunService.RenderStepped:Connect(function()
        frames += 1
        local now = tick()

        if now - lastT >= 0.5 then
            local fps = math.floor(frames / (now - lastT))
            frames, lastT = 0, now
            local col = fps >= 60 and C.Green or fps >= 30 and C.Amber or C.Red
            fpsL:SetText(Row('FPS', tostring(fps), col))
        end
    end)
    task.wait(0.09)

