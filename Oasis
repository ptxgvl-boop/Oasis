DefL:AddCheckbox("ShurikenAntiKick", {
    Text = "Anti Kick",
    Default = false,
    Callback = function(Value)
        _G.ShurikenAntiKick = Value

        local function ClearKunai()
            local plr = game.Players.LocalPlayer
            local inv = workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
            local destroyrem = game.ReplicatedStorage:FindFirstChild("MenuToys") and
                game.ReplicatedStorage.MenuToys:FindFirstChild("DestroyToy")
