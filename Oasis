LocalPlayer = LocalPlayer or Players.LocalPlayer

ESP_ENABLED = false
SMOOTH_ALPHA = 0.15
HUMAN_COLOR = Color3.fromRGB(0, 0, 0)
OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)
HUMAN_TRANSPARENCY = 0.3
OUTLINE_THICKNESS = 0.015
RainbowMode = false
RainbowHue = 0
RainbowConn = nil

espModels = {}
espConnections = {}
addedConn = nil
removingConn = nil
updateLoop = nil

function StartRainbow()
    if RainbowConn then
        RainbowConn:Disconnect()
        RainbowConn = nil
    end
    RainbowConn = RunService.RenderStepped:Connect(function(dt)
        if not RainbowMode then return end
        RainbowHue = (RainbowHue + dt * 0.5) % 1
        local c = Color3.fromHSV(RainbowHue, 1, 1)
        for _, data in pairs(espModels) do
            if data.parts then
                for _, p in pairs(data.parts) do
                    if p and p.Parent then
                        p.Color = c
                        local box = p:FindFirstChild("Outline")
                        if box then
                            box.Color3 = c
                            box.SurfaceColor3 = c
                        end
                    end
                end
            end
        end
    end)
end

function StopRainbow()
    RainbowMode = false
    if RainbowConn then
        RainbowConn:Disconnect()
        RainbowConn = nil
    end
    for _, data in pairs(espModels) do
        if data.parts then
            for _, p in pairs(data.parts) do
                if p and p.Parent then
                    p.Color = HUMAN_COLOR
                    local box = p:FindFirstChild("Outline")
                    if box then
                        box.Color3 = OUTLINE_COLOR
                        box.SurfaceColor3 = OUTLINE_COLOR
                    end
                end
            end
        end
    end
end

function clearAllESP()
    for _, conn in ipairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
    for _, data in pairs(espModels) do
        if data.model and data.model.Parent then data.model:Destroy() end
    end
    espModels = {}
    if addedConn then pcall(function() addedConn:Disconnect() end) addedConn = nil end
    if removingConn then pcall(function() removingConn:Disconnect() end) removingConn = nil end
    if updateLoop then pcall(function() updateLoop:Disconnect() end) updateLoop = nil end
end

function findPCLDOwner(pcldPart)
    local closestPlayer = nil
    local closestDistance = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        local character = p.Character
        if character then
            local root = character:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (pcldPart.Position - root.Position).Magnitude
                if d < closestDistance then
                    closestDistance = d
                    closestPlayer = p
                end
            end
        end
    end
    return closestPlayer
end

function createHumanoidForPCLD(pcldPart, ownerPlayer)
    if espModels[pcldPart] then return end

    local model = Instance.new("Model")
    model.Name = "PCLD_Humanoid_" .. ownerPlayer.Name
    model.Parent = Workspace

    local parts = {}
    local positions = {
        {name = "Torso",    size = Vector3.new(2, 2.7, 0.9)},
        {name = "Head",     size = Vector3.new(1.3, 1.3, 1.3)},
        {name = "LeftArm",  size = Vector3.new(0.9, 2.4, 0.9)},
        {name = "RightArm", size = Vector3.new(0.9, 2.4, 0.9)},
        {name = "LeftLeg",  size = Vector3.new(0.9, 2.4, 0.9)},
        {name = "RightLeg", size = Vector3.new(0.9, 2.4, 0.9)}
    }

    for _, data in ipairs(positions) do
        local p = Instance.new("Part")
        p.Name = data.name
        p.Size = data.size
        p.Color = HUMAN_COLOR
        p.Material = Enum.Material.SmoothPlastic
        p.Transparency = HUMAN_TRANSPARENCY
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.Massless = true
        p.CastShadow = false
        p.Parent = model

        local box = Instance.new("SelectionBox")
        box.Name = "Outline"
        box.Adornee = p
        box.Color3 = OUTLINE_COLOR
        box.LineThickness = OUTLINE_THICKNESS
        box.SurfaceColor3 = OUTLINE_COLOR
        box.SurfaceTransparency = 1
        box.Parent = p

        parts[data.name] = p
    end

    espModels[pcldPart] = {
        model = model,
        parts = parts,
        owner = ownerPlayer,
        currentCF = pcldPart.CFrame,
    }
end

function addPCLDRig(obj)
    if not obj or obj.Name ~= "Player3t24NpUrJMNunMMASmhAM953bFGeLXzN7" then return end
    if not obj:IsA("BasePart") then return end
    if espModels[obj] then return end
    local owner = findPCLDOwner(obj)
    if owner then
        createHumanoidForPCLD(obj, owner)
    end
end

function initialScan()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Player3t24NpUrJMNunMMASmhAM953bFGeLXzN7" and obj:IsA("BasePart") then
            addPCLDRig(obj)
        end
    end
end

function startUpdateLoop()
    if updateLoop then updateLoop:Disconnect() end
    updateLoop = RunService.RenderStepped:Connect(function(dt)
        if not ESP_ENABLED then return end
        for pcldPart, data in pairs(espModels) do
            if not pcldPart.Parent then
                if data.model and data.model.Parent then data.model:Destroy() end
                espModels[pcldPart] = nil
                continue
            end

            local owner = data.owner
            if not owner or not owner.Parent then continue end

            local char = owner.Character
            if not char or not char.Parent then continue end

            local realTorso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            local realHRP = char:FindFirstChild("HumanoidRootPart")
            if not realTorso or not realHRP then continue end

            local realLeftArm  = char:FindFirstChild("Left Arm")  or char:FindFirstChild("LeftUpperArm")
            local realRightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
            local realLeftLeg  = char:FindFirstChild("Left Leg")  or char:FindFirstChild("LeftUpperLeg")
            local realRightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")

            local alpha = 1 - math.exp(-15 * dt * SMOOTH_ALPHA * 10)
            data.currentCF = data.currentCF:Lerp(pcldPart.CFrame, alpha)
            local torsoCF = realTorso.CFrame

            data.parts.Torso.CFrame = data.currentCF
            data.parts.Head.CFrame = data.currentCF * CFrame.new(0, 2, 0)

            if realLeftArm then
                data.parts.LeftArm.CFrame = data.currentCF * torsoCF:ToObjectSpace(realLeftArm.CFrame)
            else
                data.parts.LeftArm.CFrame = data.currentCF * CFrame.new(-1.5, 0.3, 0)
            end
            if realRightArm then
                data.parts.RightArm.CFrame = data.currentCF * torsoCF:ToObjectSpace(realRightArm.CFrame)
            else
                data.parts.RightArm.CFrame = data.currentCF * CFrame.new(1.5, 0.3, 0)
            end
            if realLeftLeg then
                data.parts.LeftLeg.CFrame = data.currentCF * torsoCF:ToObjectSpace(realLeftLeg.CFrame)
            else
                data.parts.LeftLeg.CFrame = data.currentCF * CFrame.new(-0.5, -2.4, 0)
            end
            if realRightLeg then
                data.parts.RightLeg.CFrame = data.currentCF * torsoCF:ToObjectSpace(realRightLeg.CFrame)
            else
                data.parts.RightLeg.CFrame = data.currentCF * CFrame.new(0.5, -2.4, 0)
            end
        end
    end)
end

