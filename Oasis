    local bg = main:FindFirstChild("ToyBodyGyro") or Instance.new("BodyGyro", main)
    bg.Name = "ToyBodyGyro"
    bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
    bg.P = 50000

    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
        end
    end

    SyncedObjects[obj] = { main = main, bp = bp, bg = bg }
end

 function CleanupAura()
    for obj, _ in pairs(ActiveAura) do
        local data = SyncedObjects[obj]
        if data then
            if data.bp then data.bp:Destroy() end
            if data.bg then data.bg:Destroy() end
            if data.main then data.main.Anchored = true end
        end
        SyncedObjects[obj] = nil
    end
    ActiveAura = {}
end

