    main.Anchored = false

    local bp = main:FindFirstChild("ToyBodyPos") or Instance.new("BodyPosition", main)
    bp.Name = "ToyBodyPos"
    bp.MaxForce = Vector3.new(1e8, 1e8, 1e8)
