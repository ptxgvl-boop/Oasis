WhitelistDropdown = WhitelistGroup:AddDropdown("WhitelistDropdown", {
    Text = "Select Player",
    Values = GetWhitelistPlayerList(),
    Default = nil,
    Multi = true,
    Searchable = true,
    Callback = function(selectedMap)
        if WhitelistUpdating then return end
        if typeof(selectedMap) ~= "table" then return end

        for entry, state in pairs(selectedMap) do
            local username = entry:match("@([%w_]+)%)")
            if username then
                if state then
                    if not WhitelistUsers[username] then
                        WhitelistUsers[username] = true
                        Library:Notify({
                            Title = "<b>PredatorX</b>",
                            Description = "Whitelisted: " .. username,
                            Icon = "rbxassetid://116176143011396",
                            Duration = 3
                        })
                    end
                else
                    if WhitelistUsers[username] then
                        WhitelistUsers[username] = nil
                        AutoWhitelistedFriends[username] = nil
                        Library:Notify({
                            Title = "<b>PredatorX</b>",
                            Description = "Removed from whitelist: " .. username,
                            Icon = "rbxassetid://116176143011396",
                            Duration = 3
                        })
                    end
                end
            end
        end
    end
})

