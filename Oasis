function H.isnetworkowner(part)
    if typeof(part) ~= "Instance" or not part:IsA("BasePart") then return false end
    local checkPart = part
    if part.Massless and part.AssemblyRootPart then checkPart = part.AssemblyRootPart end
    if not checkPart or checkPart.Anchored then return false end
    if type(isnetworkowner) == "function" then
        local ok, owned = pcall(isnetworkowner, checkPart)
        if ok and type(owned) == "boolean" then return owned end
    end
    local ok, receiveAge = pcall(function() return checkPart.ReceiveAge end)
    return ok and receiveAge == 0
end

function H.ispartowner(part)
    if typeof(part) ~= "Instance" or not part:IsA("BasePart") then return false end
    if part.Name == "HumanoidRootPart" then
        local parent = part.Parent
        if parent then
            local head = parent:FindFirstChild("Head")
            if head then
                local owner = head:FindFirstChild("PartOwner")
                if owner then return owner.Value == Def_LocalPlayer.Name end
            end
        end
    end
    local owner = part:FindFirstChild("PartOwner")
    if owner and owner.Value == Def_LocalPlayer.Name then return true end
    local parent = part.Parent
    if not parent then return false end
    owner = parent:FindFirstChild("PartOwner", true)
    if not owner then return false end
    return owner.Value == Def_LocalPlayer.Name
end

