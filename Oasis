local SKIP_PARTS = {
	HumanoidRootPart = true,
	Handle = true,
	LArmIKPart = true,
	RArmIKPart = true,
}

function Fun.stopHipDanceV2(char)
	if Fun.poseConnectionV2 then
		Fun.poseConnectionV2:Disconnect()
		Fun.poseConnectionV2 = nil
	end
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end
	end
end

function Fun.startHipDanceV2(char)
	if not Fun.activeDanceDataV2 then return end
	Fun.stopHipDanceV2(char)
	local rootPart = char:WaitForChild("HumanoidRootPart")
	local humanoid = char:WaitForChild("Humanoid")
	if Fun.RagdollRemote then
		Fun.RagdollRemote:FireServer(rootPart, 9999999)
	else
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end
	local movePosition = rootPart.Position
	local walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
	local teleportThreshold = 8
	local totalFrames = #Fun.activeDanceDataV2.frames
	if totalFrames == 0 then return end
	Fun.frameIndexV2 = 1
	Fun.frameTimerV2 = 0

	function parseCFrameData(data)
		return CFrame.new(
			data[1], data[2], data[3],
			data[4], data[5], data[6],
			data[7], data[8], data[9],
			data[10], data[11], data[12]
		)
	end

	Fun.poseConnectionV2 = Fun.RunService.Heartbeat:Connect(function(dt)
		if not char or not char.Parent or not rootPart or not rootPart.Parent then return end
		local cameraLook = Fun.camera.CFrame.LookVector
		local yawAngle = math.atan2(-cameraLook.X, -cameraLook.Z)
		local actualPosition = rootPart.Position
		if (actualPosition - movePosition).Magnitude > teleportThreshold then
			movePosition = actualPosition
		end
		local moveDir = humanoid.MoveDirection
		if moveDir.Magnitude > 0.01 then
			movePosition = movePosition + moveDir * walkSpeed * dt
		end
		local targetCFrame = CFrame.new(movePosition) * CFrame.Angles(0, yawAngle, 0)
		rootPart.CFrame = targetCFrame
		rootPart.AssemblyLinearVelocity = Vector3.zero
		Fun.frameTimerV2 = Fun.frameTimerV2 + dt
		local shouldLoop = false
		if Fun.frameTimerV2 >= Fun.activeDanceDataV2.interval then
			Fun.frameTimerV2 = Fun.frameTimerV2 - Fun.activeDanceDataV2.interval
			Fun.frameIndexV2 = Fun.frameIndexV2 + 1
			if Fun.frameIndexV2 > totalFrames then
				Fun.frameIndexV2 = 1
				shouldLoop = true
			end
		end
		local currentFrame = Fun.activeDanceDataV2.frames[Fun.frameIndexV2]
		local nextFrameIndex = Fun.frameIndexV2 < totalFrames and Fun.frameIndexV2 + 1 or 1
		local nextFrame = Fun.activeDanceDataV2.frames[nextFrameIndex]
		local alpha = shouldLoop and 1 or (Fun.frameTimerV2 / Fun.activeDanceDataV2.interval)
		for partName, partData in pairs(currentFrame.parts) do
			if SKIP_PARTS[partName] then continue end
			local part = char:FindFirstChild(partName)
			if part and part:IsA("BasePart") then
				local nextPartData = nextFrame.parts[partName] or partData
				local currentCF = parseCFrameData(partData)
				local nextCF = parseCFrameData(nextPartData)
				local lerpedCF = currentCF:Lerp(nextCF, alpha)
				part.CFrame = targetCFrame * lerpedCF
				part.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
end

function Fun.refreshDanceV2List()
	Fun.currentDanceRawTableV2 = {}
	local success, response = pcall(function()
		return game:HttpGet("https://raw.githubusercontent.com/dcus-official/PoopHub/refs/heads/main/Assets/Emote/List_Json.lua")
	end)
	if success and response then
		local parseSuccess, loadedTable = pcall(function()
			local func = loadstring(response)
			if func then return func() end
		end)
		if parseSuccess and type(loadedTable) == "table" then
			for name, rawJson in pairs(loadedTable) do
				Fun.currentDanceRawTableV2[name] = rawJson
			end
		end
	end

	if not isfolder("PoopHub") then makefolder("PoopHub") end
	if not isfolder("PoopHub/FTAP") then makefolder("PoopHub/FTAP") end
	if not isfolder("PoopHub/FTAP/Emote") then makefolder("PoopHub/FTAP/Emote") end

	local localSuccess, files = pcall(function()
		return listfiles("PoopHub/FTAP/Emote")
	end)
	if localSuccess and type(files) == "table" then
		for _, filepath in ipairs(files) do
			if filepath:match("%.dance$") then
				local name = filepath:gsub("\\", "/"):match("([^/]+)%.dance$")
				if name then
					local fileContentSuccess, content = pcall(function()
						return readfile(filepath)
					end)
					if fileContentSuccess and content then
						Fun.currentDanceRawTableV2[name] = content
					end
				end
			end
		end
	end

	table.clear(Fun.danceListV2)
	for name, _ in pairs(Fun.currentDanceRawTableV2) do
		table.insert(Fun.danceListV2, name)
	end
	table.sort(Fun.danceListV2)
	if #Fun.danceListV2 == 0 then
		table.insert(Fun.danceListV2, "No dances found")
	end

	if Options.DanceV2Dropdown then
		Options.DanceV2Dropdown:SetValues(Fun.danceListV2)
		if #Fun.danceListV2 > 0 and Fun.danceListV2[1] ~= "No dances found" then
			Options.DanceV2Dropdown:SetValue(Fun.danceListV2[1])
		end
	end
end

