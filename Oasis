local AimRayParams = RaycastParams.new()
AimRayParams.FilterType = Enum.RaycastFilterType.Exclude

 function GetAimTarget()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local camPos = Camera.CFrame.Position
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local radiusSq = AimConfig.FOVRadius * AimConfig.FOVRadius
    local distSq   = AimConfig.Distance * AimConfig.Distance

    local best, bestScore = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer
           and not (IsWL(plr) and not AimConfig.IgnoreWhitelist)
           and plr.Character then

            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild(AimConfig.TargetPart)
            local hrp  = plr.Character:FindFirstChild("HumanoidRootPart")

            if hum and hum.Health > 0 and part and hrp then
                -- in range?
                local delta = hrp.Position - myRoot.Position
                if delta:Dot(delta) <= distSq then
                    -- on screen?
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dx = screenPos.X - viewportCenter.X
                        local dy = screenPos.Y - viewportCenter.Y
                        local screenDistSq = dx * dx + dy * dy

                        if screenDistSq <= radiusSq and screenDistSq < bestScore then
                            -- raycast check
                            AimRayParams.FilterDescendantsInstances = {char, plr.Character}
                            local hit = Workspace:Raycast(camPos, part.Position - camPos, AimRayParams)
                            if not hit then
                                best = plr
                                bestScore = screenDistSq
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

