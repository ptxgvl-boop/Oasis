                cam.CameraType = Enum.CameraType.Scriptable
                cam.CFrame = SavedCamCFrame
                camBlocker.CFrame = SavedCamCFrame
                camBlocker.Parent = Workspace
            end
        end)
    end

    local function stopBringAll()
