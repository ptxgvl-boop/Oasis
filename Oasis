local function stealAntiKickLoop()
    while StealAntiKickEnabled do
        for _, targetPlayer in pairs(AllTargets) do
            local hrp, humanoid = GetHRH(char)
            local toysFolder = workspace:FindFirstChild(targetPlayer.Name .. "SpawnedInToys")

            if hrp and humanoid and humanoid.Health > 0 and toysFolder then
                for _, toy in pairs(toysFolder:GetChildren()) do
                    local stickyPart = toy:FindFirstChild("StickyPart")

                    if stickyPart and stickyPart:FindFirstChild("StickyWeld") then
                        local weldPart1 = stickyPart.StickyWeld.Part1

                        if not weldPart1 or (weldPart1.Parent and weldPart1.Parent ~= char) then
                            for _, part in pairs(toy:GetChildren()) do
                                if (part:IsA("Part") or part:IsA("MeshPart"))
                                    and part.CanQuery
                                    and (part.Position - hrp.Position).Magnitude <= 25
                                then
                                    if Ownerboat(part) and part.Parent and part.Parent:FindFirstChild("StickyPart") then
                                        StickyPartEvent:FireServer(
                                            part.Parent:FindFirstChild("StickyPart"),
                                            hrp,
                                            CFrame.new(0, -4.5, 0)
                                        )
                                        task.wait(0.1)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        task.wait()
    end
end

local function removeAntiKickLoop()
    while RemoveAntiKickEnabled do
        if not SelectedTarget then
            break
        end

        local targetPlayer = Players:FindFirstChild(SelectedTarget)

        if targetPlayer then
            local hrp, humanoid = GetHRH(char)
            local targetHRP = targetPlayer.Character
                and targetPlayer.Character:FindFirstChild("HumanoidRootPart")

            if hrp and humanoid and humanoid.Health > 0 and targetHRP then
                local toysFolder = workspace:FindFirstChild(targetPlayer.Name .. "SpawnedInToys")

                if toysFolder then
