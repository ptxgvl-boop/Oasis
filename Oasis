local function DestroyGucciBlobman()
    local targetPlayer = getTargetPlayer()

    if not targetPlayer or not targetPlayer.Character then
        Library:Notify({
            Title = "Error",
            Content = "Target not selected",
            Time = 3,
        })
        return
    end

    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")

    if not targetHRP or not targetHumanoid then
        Library:Notify({
            Title = "Error",
            Content = "Target character not ready",
            Time = 3,
        })
        return
    end

    local creatureBlobman = inv
        and (inv:FindFirstChild("CreatureBlobman") or inv:FindFirstChild("blobmangucci"))

    if not creatureBlobman then
        creatureBlobman = fn21(
            "CreatureBlobman",
            (HRP and HRP.CFrame or CFrame.new(0, 0, 0)) * CFrame.new(0, 4, 0)
        )
    end

    if not creatureBlobman then
        return
    end

    local originalPivot = char and char:GetPivot()

    targetHRP.Massless = false

    local vehicleSeat = creatureBlobman:FindFirstChild("VehicleSeat")

    if vehicleSeat then
        vehicleSeat:Sit(hum)

        while not hum or not hum.SeatPart do
            task.wait()
        end
    end

    local blobmanScript = creatureBlobman:FindFirstChild("BlobmanSeatAndOwnerScript")
    local creatureGrab = blobmanScript and blobmanScript:FindFirstChild("CreatureGrab")
    local creatureRelease = blobmanScript and blobmanScript:FindFirstChild("CreatureRelease")
    local rightDetector = creatureBlobman:FindFirstChild("RightDetector")
    local rightWeld = rightDetector and rightDetector:FindFirstChild("RightWeld")

    if creatureBlobman and creatureBlobman:IsDescendantOf(workspace) then
        creatureBlobman:PivotTo(targetHRP.CFrame)
    end

    task.wait(0.15)

    for _ = 1, 15 do
        pcall(function()
            if creatureGrab and rightDetector and rightWeld then
                creatureGrab:FireServer(rightDetector, targetHRP, rightWeld)
            end
        end)

        pcall(function()
            if creatureRelease and rightWeld then
                creatureRelease:FireServer(rightWeld, targetHRP)
            end
        end)

        targetHRP.Massless = false

        for _ = 1, 10 do
            if targetHumanoid then
                targetHumanoid.Sit = true
            end
        end

        task.wait()
    end

    if char and originalPivot then
        char:PivotTo(originalPivot)
    end
