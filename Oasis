function H.grab(part, cframe)
    local _, localRoot, humanoid = H.charp()
    if not localRoot or not humanoid or humanoid.Health == 0 then return end
    if not part or not part.Parent or not part:IsA("BasePart") then return end
    if not remotes.sno then return end
    local sourceCFrame = cframe or localRoot.CFrame
    if typeof(sourceCFrame) ~= "CFrame" then return end
    sourceCFrame = sourceCFrame * CFrame.new(0, 1.593, 0)
    local grabCFrame = CFrame.new(sourceCFrame.Position, part.Position)
    remotes.sno:FireServer(part, grabCFrame)
end

function H.sno(part, duration)
    if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part.Parent then return false end
    local character, localRoot, humanoid = H.charp()
    local localHead = character and character:FindFirstChild("Head")
    local ragdolled = humanoid and humanoid:FindFirstChild("Ragdolled")
    if not character or not localHead or not localRoot or not humanoid or not ragdolled or humanoid.Health <= 0 then
        return false
    end
    if H.ispartowner(part) then return true end

    local savedRootCFrame = localRoot.CFrame
    local savedHeadCFrame = localHead.CFrame
    local desiredRootCFrame = savedRootCFrame
    local moveLocal = (localRoot.Position - part.Position).Magnitude >= 31
    local hbConn = nil

    if moveLocal then
        pcall(function() Def_RunService:UnbindFromRenderStep("RSCClient") end)
        Def_RunService:BindToRenderStep("RSCClient", Enum.RenderPriority.Camera.Value - 1, function()
            if localRoot.Parent then localRoot.CFrame = savedRootCFrame end
            if localHead.Parent then localHead.CFrame = savedHeadCFrame end
        end)
        hbConn = Def_RunService.Heartbeat:Connect(function()
            if not localRoot.Parent or not localHead.Parent then return end
            savedRootCFrame = localRoot.CFrame
            savedHeadCFrame = localHead.CFrame
            localRoot.CFrame = desiredRootCFrame
            localHead.CFrame = desiredRootCFrame
        end)
    end

    local timeout = tonumber(duration) or 0.65
    local started = tick()
    while part.Parent and not H.ispartowner(part)
        and humanoid.Health ~= 0 and localRoot.Parent
        and tick() - started < timeout
    do
        if moveLocal then desiredRootCFrame = part.CFrame - Vector3.new(0, 22, 0) end
        Def_RunService.Heartbeat:Wait()
        H.grab(part, moveLocal and desiredRootCFrame or nil)
    end

    if moveLocal then
        pcall(function() Def_RunService:UnbindFromRenderStep("RSCClient") end)
        if hbConn then hbConn:Disconnect() end
        if localHead.Parent then localHead.CFrame = savedHeadCFrame end
        if localRoot.Parent then localRoot.CFrame = savedRootCFrame end
    end
    return H.ispartowner(part)
end

function H.ragdoll(subject, duration)
    local character = nil
    local targetPart = nil
    local humanoid = nil
    if typeof(subject) ~= "Instance" then return end
    if subject:IsA("Player") then
        character = subject.Character
        if character then
            targetPart = character:FindFirstChild("Torso")
            humanoid = character:FindFirstChild("Humanoid")
        end
    elseif subject:IsA("Model") then
        character = subject
        if not character:FindFirstChild("Head") then return end
        targetPart = character:FindFirstChild("Torso")
        humanoid = character:FindFirstChild("Humanoid")
    elseif subject:IsA("BasePart") then
        targetPart = subject
        if subject.Parent and subject.Parent:IsA("Model") then
            character = subject.Parent
            humanoid = character:FindFirstChild("Humanoid")
        end
    else
        return
    end
    if not targetPart or not targetPart:IsA("BasePart") or not targetPart.Parent or not humanoid then return end
    local ragdolled = humanoid:FindFirstChild("Ragdolled")
    if not ragdolled then return end
    if ragdolled.Value ~= false then return end
    if defState.States.Ragdolling then return end
    targetPart.CanCollide = false
    defState.States.Ragdolling = true
    local spawnedFolder = Def_Workspace:FindFirstChild(Def_LocalPlayer.Name .. "SpawnedInToys")
    if not spawnedFolder then defState.States.Ragdolling = false return end
    local toy = spawnedFolder:FindFirstChild("RagdollRSC")
    if not toy then
        if remotes.spawnEvent then
            pcall(function() remotes.spawnEvent:InvokeServer("PalletLightBrown", targetPart.CFrame, Vector3.zero) end)
        end
        task.wait(0.3)
        toy = spawnedFolder:FindFirstChild("PalletLightBrown")
    end
    if not toy then defState.States.Ragdolling = false return end
    local soundPart = toy:WaitForChild("SoundPart", 0.5)
    local main = toy:WaitForChild("Main", 0.5)
    if not soundPart or not main then defState.States.Ragdolling = false H.dt(toy) return end
    if not H.sno(soundPart) then defState.States.Ragdolling = false H.dt(toy) return end
    toy.Name = "RagdollRSC"
    local bp = main:FindFirstChild("RagdollBP")
    if bp and not bp:IsA("BodyPosition") then bp:Destroy() bp = nil end
    if not bp then
        bp = Instance.new("BodyPosition")
        bp.Name = "RagdollBP"
        bp.D = 1500
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.Position = Vector3.new(0, 100000, 0)
        bp.Parent = main
    else
        bp.D = 1500
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.Position = Vector3.new(0, 100000, 0)
    end
    local started = tick()
    while toy.Parent and soundPart.Parent and targetPart.Parent and ragdolled.Parent
        and ragdolled.Value ~= true and tick() - started <= 0.5
    do
        soundPart.Position = targetPart.Position
        soundPart.Velocity = Vector3.new(0, -10, 0)
        task.wait(0.1)
    end
    defState.States.Ragdolling = false
    return ragdolled.Value
end

function H.breaklimb(player, limbMode)
    local isLocal = player == Def_LocalPlayer
    if isLocal and runtimeFlags.GucciAntiGrab then return false end
    local character, rootPart, humanoid = H.charp(player)
    local ragdolled = humanoid and humanoid:FindFirstChild("Ragdolled")
    if not rootPart or not humanoid or humanoid.Health == 0 or not ragdolled then return false end
    local children = character:GetChildren()
    local found = false
    local function match(part)
        if not part:IsA("BasePart") then return false end
        local isArm = part.Name:find("Arm") ~= nil
        local isLeg = part.Name:find("Leg") ~= nil
        if limbMode == "Arms" then return isArm end
        if limbMode == "Legs" then return isLeg end
        if limbMode == "All" then return isArm or isLeg end
        return false
    end
    for _, part in ipairs(children) do
        if match(part) then found = true break end
    end
    if not found then return false end
    if isLocal then
        if not remotes.RagdollRemote then return false end
        remotes.RagdollRemote:FireServer(rootPart, 0.35)
        local started = tick()
        while true do
            task.wait()
            if ragdolled.Value then break end
            if tick() - started > 0.5 then break end
        end
    else
        if not H.sno(rootPart) then return false end
        if not H.ragdoll(character) then return false end
    end
    if not ragdolled.Value then return false end
    for _, part in ipairs(children) do
        if match(part) then part.CFrame = CFrame.new(0, -100000, 0) end
    end
    task.wait(0.15)
    if isLocal then
        H.grab(rootPart)
        task.wait()
        if remotes.RagdollRemote then remotes.RagdollRemote:FireServer(rootPart, 0) end
    else
        Def_Workspace.FallenPartsDestroyHeight = -1000
        H.teleport(rootPart, CFrame.new(0, -1100, 0))
        task.wait()
        Def_Workspace.FallenPartsDestroyHeight = runtimeFlags.DestroyVoid and (0/0) or -100
        H.unsno(rootPart)
    end
    return true
end

function H.kill(player)
    local _, rootPart, humanoid = H.charp(player)
    if humanoid and humanoid.Health ~= 0 and rootPart then
        local _ = Def_Workspace:FindFirstChild("SpawnLocation") and H.getMagnitude(Def_Workspace.SpawnLocation, rootPart)
        if H.sno(rootPart) then
            humanoid.BreakJointsOnDeath = false
            humanoid.Sit = false
            humanoid:ChangeState(Enum.HumanoidStateType.Dead)
            H.teleport(rootPart, CFrame.new(0, 9000000000, 0))
            task.delay(2, H.unsno, rootPart)
        end
    end
end

function H.void(player)
    local _, rootPart, humanoid = H.charp(player)
    if humanoid and humanoid.Health ~= 0 and rootPart then
        local spawn = Def_Workspace:FindFirstChild("SpawnLocation")
        if (not spawn or H.getMagnitude(spawn, rootPart) < 15000) and H.sno(rootPart) then
            H.teleport(rootPart, CFrame.new(0, 9000000000, 0))
            rootPart.Velocity = Vector3.new(0, 9000000000, 0)
            task.delay(0.35, H.unsno, rootPart)
        end
    end
end

function H.FormatPlayer(player)
    if typeof(player) ~= "Instance" or not player:IsA("Player") then return tostring(player) end
    if player == Def_LocalPlayer then return "You" end
    if player.DisplayName == player.Name then return player.Name end
    return string.format("%s (@%s)", player.DisplayName, player.Name)
end

