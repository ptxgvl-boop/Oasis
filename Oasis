function startFling(target)
    if not target or not target.Parent then return end
    local name = target.Name
    if PrXFlingThread[name] then return end

    PrXFlingActive[name] = true

    PrXFlingThread[name] = task.spawn(function()
        while PrXFlingActive[name] and NonActionRunning and target and target.Parent do
            pcall(function()
                local tChar = target.Character
                if not tChar then return end
                local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar:FindFirstChild("Humanoid")
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not tRoot or not tHum or tHum.Health <= 0 or not myRoot then return end

                ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(tRoot)

                if not PrXFlingBAV[name] or not PrXFlingBAV[name].Parent then
                    PrXFlingBAV[name] = Instance.new("BodyAngularVelocity")
                    PrXFlingBAV[name].MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    PrXFlingBAV[name].AngularVelocity = Vector3.new(math.random(-9999, 9999), math.random(-9999, 9999), math.random(-9999, 9999))
                    PrXFlingBAV[name].P = 10000
                    PrXFlingBAV[name].Parent = tRoot
                end

                local dir = (tRoot.Position - myRoot.Position)
                if dir.Magnitude > 0 then dir = dir.Unit else dir = Vector3.new(0, 1, 0) end

                tRoot.AssemblyLinearVelocity = dir * 5000 + Vector3.new(0, 500, 0)
            end)
            task.wait(0.05)
        end

        if PrXFlingBAV[name] then
            pcall(function() PrXFlingBAV[name]:Destroy() end)
            PrXFlingBAV[name] = nil
        end
        PrXFlingActive[name] = false
        PrXFlingThread[name] = nil
    end)
end

function stopFling(target)
