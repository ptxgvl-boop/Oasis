    ActiveAura = {}
    local target = AuraConfig.ToyName
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == target then
            if not AuraConfig.OnlyMine or IsMyToy(obj) then
                SetupPhysics(obj)
                ActiveAura[obj] = true
            end
        end
    end
end

