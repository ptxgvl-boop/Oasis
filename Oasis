function getMyPlotFolder()
    local plots = workspace:FindFirstChild("Plots")
    local plotItems = workspace:FindFirstChild("PlotItems")
    if not plots or not plotItems then return nil end

    for i = 1, 5 do
        local plot = plots:FindFirstChild("Plot" .. i)
        if plot then
            local sign = plot:FindFirstChild("PlotSign")
            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
            if owners then
                for _, v in ipairs(owners:GetChildren()) do
                    if v.Value == LocalPlayer.Name then
                        return plotItems:FindFirstChild("Plot" .. i)
                    end
                end
            end
        end
    end
    return nil
end

function isChristmasHouse(obj)
    local nameLower = obj.Name:lower()
    return nameLower:find("christmas")
        or nameLower:find("gingerbread")
        or nameLower:find("playhouse")
end

function getChristmasHouses()
    local houses = {}
    local seen = {}

    local function scanFolder(folder)
        if not folder then return end
        for _, obj in ipairs(folder:GetChildren()) do
            if isChristmasHouse(obj) and not seen[obj] then
                local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if primary then
                    seen[obj] = true
                    table.insert(houses, {model = obj, primary = primary})
                end
            end
        end
    end

    scanFolder(workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys"))
    scanFolder(getMyPlotFolder())

    return houses
end

function startSyncChristmasHouse()
    if SyncChristmasHouseTask then
        task.cancel(SyncChristmasHouseTask)
        SyncChristmasHouseTask = nil
    end

    SyncChristmasHouseActive = true
    SyncChristmasHouseAngle = 0

    SyncChristmasHouseTask = task.spawn(function()
        while SyncChristmasHouseActive do
            task.wait()

            local center
            if SyncChristmasHouseTarget and SyncChristmasHouseTarget.Parent then
                local tChar = SyncChristmasHouseTarget.Character
                local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
                if tHRP then
                    center = tHRP.Position
                end
            end

            if not center then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    center = hrp.Position
                end
            end

            if not center then
                task.wait(0.5)
                continue
            end

            local houses = getChristmasHouses()
            if #houses == 0 then
                task.wait(0.5)
                continue
            end

            local count = #houses
            local angleStep = (math.pi * 2) / count

            SyncChristmasHouseAngle += math.rad(SyncChristmasHouseSpeed) * (1 / 60)

            local radius = SyncChristmasHouseRadius + SyncChristmasHouseDistance

            for i, h in ipairs(houses) do
                if not h.model or not h.model.Parent then continue end

                local angle = SyncChristmasHouseAngle + (i - 1) * angleStep
                local x = math.cos(angle) * radius
                local z = math.sin(angle) * radius

                local targetPos = center + Vector3.new(
                    x,
                    SyncChristmasHouseHeight,
                    z
                )

                pcall(function()
                    h.model:PivotTo(CFrame.new(targetPos))
                end)
            end
        end
    end)
end

function stopSyncChristmasHouse()
    SyncChristmasHouseActive = false
    if SyncChristmasHouseTask then
        pcall(function() task.cancel(SyncChristmasHouseTask) end)
        SyncChristmasHouseTask = nil
    end
end

