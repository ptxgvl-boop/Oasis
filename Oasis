local scriptSettings = {
    SIL = true,
    dist = 30,
    wallCheck = true,
    showNotifications = true,
    selectedTarget = nil,
    targetSelectionMode = "closest",
}

 local originalNamecall
 local renderConnection
 local charAddedConnection
 updateLoopLogic = nil
 checkInterval = 0.05

 function STS()
    local Hitbox = {"Head", "Torso", "Left Leg", "Right Leg"}

    local function GetClosest()
        if scriptSettings.targetSelectionMode == "selected" and scriptSettings.selectedTarget then
            if scriptSettings.selectedTarget and scriptSettings.selectedTarget.Character
                and scriptSettings.selectedTarget.Character:FindFirstChild("HumanoidRootPart")
                and scriptSettings.selectedTarget.Character:FindFirstChildOfClass("Humanoid")
                and scriptSettings.selectedTarget.Character:FindFirstChildOfClass("Humanoid").Health > 0 then

                if scriptSettings.wallCheck and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local playerPosition = localPlayer.Character.HumanoidRootPart.Position
                    local targetPosition = scriptSettings.selectedTarget.Character.HumanoidRootPart.Position
                    local distance = (playerPosition - targetPosition).magnitude
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterDescendantsInstances = {localPlayer.Character, scriptSettings.selectedTarget.Character}
                    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                    local raycastResult = workspace:Raycast(playerPosition, (targetPosition - playerPosition).Unit * distance, raycastParams)
                    if not raycastResult and distance <= (scriptSettings.dist or 30) then return scriptSettings.selectedTarget else return nil end
                elseif not scriptSettings.wallCheck and distance <= (scriptSettings.dist or 30) then return scriptSettings.selectedTarget else return scriptSettings.selectedTarget end
            else return nil end
        end

        local Target, Closest = nil, math.huge
        for _, player in pairs(PS:GetPlayers()) do
            if player ~= localPlayer and player.Character and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local character = player.Character
                local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoidRootPart and humanoid and humanoid.Health > 0 then
                    local playerPosition = localPlayer.Character.HumanoidRootPart.Position
                    local targetPosition = humanoidRootPart.Position
                    local distance = (playerPosition - targetPosition).magnitude
                    local _, onScreen = Cam:WorldToScreenPoint(humanoidRootPart.Position)

                    if onScreen and distance <= (scriptSettings.dist or 30) and distance < Closest then
                        if scriptSettings.wallCheck then
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {localPlayer.Character, character}
                            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                            local raycastResult = workspace:Raycast(playerPosition, (targetPosition - playerPosition).Unit * distance, raycastParams)
                            if not raycastResult then Closest = distance; Target = player end
                        else
                            Closest = distance; Target = player
                        end
                    end
                end
            end
        end
        return Target
    end

    local Target
    local part, partn, ch
    local lastCheck = 0

    local function UpdateLoop()
        if renderConnection then renderConnection:Disconnect() renderConnection = nil end
        if scriptSettings.SIL then
            Target = nil
            renderConnection = R.RenderStepped:Connect(function()
                local now = tick()
                if now - lastCheck >= checkInterval then
                    Target = GetClosest()
                    lastCheck = now
                end
            end)
        else
            Target = nil
        end
    end

    local function CalculateDirection(Origin, Destination, Length)
        return (Destination - Origin).Unit * Length
    end

    local success, hookResult = pcall(function()
        originalNamecall = hookmetamethod(game, "__namecall", function(...)
            local args = {...}
            local self = args[1]
            local method = getnamecallmethod()

            if not scriptSettings.SIL then return originalNamecall(unpack(args)) end

            if self == workspace and not checkcaller() and method == "Raycast" then
                if Target and Target.Character and Target.Character.HumanoidRootPart
                    and localPlayer.Character and localPlayer.Character.HumanoidRootPart
                    and Target.Character.Humanoid and Target.Character.Humanoid.Health > 0 then
                    local playerPosition = localPlayer.Character.HumanoidRootPart.Position
                    local targetPosition = Target.Character.HumanoidRootPart.Position
                    local distance = (playerPosition - targetPosition).magnitude
                    part = math.random(1, #Hitbox)
                    partn = Hitbox[part]
                    ch = Target.Character[partn]
                    if distance <= (scriptSettings.dist or 30) and ch then
                        args[3] = CalculateDirection(args[2], Target.Character[partn].Position, 1000)
                        args[4] = RaycastParams.new()
                        args[4].FilterDescendantsInstances = {Target.Character}
                        args[4].FilterType = Enum.RaycastFilterType.Include
                        part = nil; partn = nil; ch = nil
                    end
                end
            end
            return originalNamecall(unpack(args))
        end)
    end)

    if not success then
        scriptSettings.SIL = false
        pcall(function() Library:Notify({Title="Silent Aim Error", Description="Executor does not support hookmetamethod. Silent Aim disabled.", Time=5}) end)
    end

    updateLoopLogic = UpdateLoop
    return UpdateLoop
end

