                return math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            end)

            if ok and ping and ping ~= lastPing then
                lastPing = ping
                local col = ping <= 80 and C.Green or ping <= 150 and C.Amber or C.Red
                pingL:SetText(Row('Ping', ping .. ' ms', col))
            end
        end
    end)
    task.wait(0.09)

