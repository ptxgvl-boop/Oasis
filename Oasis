do
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer       = Players.LocalPlayer

local Cfg = {
    Enabled      = false,
    LegPairs     = 4,
    LegSpread    = 8,
    LegLift      = 5,
    FootRadius   = 6,
    ToyName      = "LadderLightBrown",
    StepDist     = 4,
    StepSpeed    = 0.4,
    StepHeight   = 2,
    BobSpeed     = 3,
    BobAmount    = 0.6,
}

local State = {
    Legs = {},
    BodyPart = nil,
    LastPos = Vector3.zero,
}

local SpawnToyRF  = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local DestroyToy  = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
local GrabEvents  = ReplicatedStorage:WaitForChild("GrabEvents")
local SetNetOwner = GrabEvents:WaitForChild("SetNetworkOwner")

local function SNO(part)
    pcall(function() SetNetOwner:FireServer(part, part.CFrame) end)
end

local function GetFolder()
    return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

local function SpawnToyAt(name, cf)
    local folder = GetFolder()
    if not folder then return nil end
    local existing = {}
    for _, c in ipairs(folder:GetChildren()) do existing[c] = true end
    pcall(function() SpawnToyRF:InvokeServer(name, cf, Vector3.zero) end)
    local t0 = tick()
    while tick() - t0 < 2 do
        for _, c in ipairs(folder:GetChildren()) do
            if not existing[c] and c.Name == name then return c end
        end
        task.wait()
    end
    return nil
end

local function Setup(part)
    if not part:IsA("BasePart") then return end
    part.Anchored = false
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    pcall(function()
        if part:CanSetNetworkOwnership() then
            part:SetNetworkOwner(LocalPlayer)
        end
    end)
    SNO(part)
end

local function BuildBody()
    local body = SpawnToyAt(Cfg.ToyName, CFrame.new(0, 5000, 0))
    if not body then return nil end
    body.Name = "SpiderCore"
    for _, p in ipairs(body:GetDescendants()) do Setup(p) end
    local main = body.PrimaryPart or body:FindFirstChildWhichIsA("BasePart")
    if not main then
        pcall(function() DestroyToy:FireServer(body) end)
        return nil
    end
    body.PrimaryPart = main
    main.Anchored = true
    State.BodyPart = body
    return body
end

local function BuildLegPair(pairIndex, total, bodyMain)
    local angle = ((pairIndex - 1) / total) * math.pi * 2

    local apexOffset = Vector3.new(
        math.cos(angle) * Cfg.LegSpread * 0.3,
        0,
        math.sin(angle) * Cfg.LegSpread * 0.3
    )

    local apexWorld = bodyMain.CFrame * CFrame.new(apexOffset)
    local footLeft  = bodyMain.CFrame * CFrame.new(
        apexOffset.X + math.cos(angle - math.pi / 2) * Cfg.FootRadius,
        -Cfg.LegLift,
        apexOffset.Z + math.sin(angle - math.pi / 2) * Cfg.FootRadius
    )
    local footRight = bodyMain.CFrame * CFrame.new(
        apexOffset.X + math.cos(angle + math.pi / 2) * Cfg.FootRadius,
        -Cfg.LegLift,
        apexOffset.Z + math.sin(angle + math.pi / 2) * Cfg.FootRadius
    )

    local function makeLeg(footCF, sideName)
        local seg = SpawnToyAt(Cfg.ToyName, apexWorld:Lerp(footCF, 0.5))
        if not seg then return nil end
        seg.Name = "SpiderLeg_" .. pairIndex .. "_" .. sideName
        for _, p in ipairs(seg:GetDescendants()) do Setup(p) end
        local main = seg.PrimaryPart or seg:FindFirstChildWhichIsA("BasePart")
        if not main then
            pcall(function() DestroyToy:FireServer(seg) end)
            return nil
        end
        seg.PrimaryPart = main
        main.Anchored = false

        local apexAttach = Instance.new("Attachment", bodyMain)
        apexAttach.Name = "Apex_" .. pairIndex .. "_" .. sideName
        apexAttach.Position = apexOffset

        local topAttach = Instance.new("Attachment", main)
        topAttach.Name = "Top"
        topAttach.Position = Vector3.new(0, main.Size.Y * 0.5, 0)

        local joint = Instance.new("BallSocketConstraint")
        joint.Name = "Joint_" .. pairIndex .. "_" .. sideName
        joint.Attachment0 = apexAttach
        joint.Attachment1 = topAttach
        joint.LimitsEnabled = true
        joint.UpperAngle = 70
        joint.TwistLimitsEnabled = true
        joint.TwistLowerAngle = -70
        joint.TwistUpperAngle = 70
        joint.Parent = bodyMain

        return {
            Part      = seg,
            Main      = main,
            Apex      = apexAttach,
            Top       = topAttach,
            Joint     = joint,
            ApexOffset= apexOffset,
            BaseFoot  = footCF.Position,
            FootTarget= nil,
            Stepping  = false,
            StepFrom  = nil,
            StepTo    = nil,
            StepStart = 0,
            Side      = sideName,
        }
    end

    local legL = makeLeg(footLeft, "L")
    local legR = makeLeg(footRight, "R")

    State.Legs[pairIndex] = { L = legL, R = legR }
end

local function ClearAll()
    for i, pair in pairs(State.Legs) do
        for _, leg in pairs(pair) do
            if leg then
                if leg.Part then pcall(function() DestroyToy:FireServer(leg.Part) end) end
                if leg.Apex then leg.Apex:Destroy() end
                if leg.Joint then leg.Joint:Destroy() end
            end
        end
    end
    State.Legs = {}
    if State.BodyPart then
        pcall(function() DestroyToy:FireServer(State.BodyPart) end)
        State.BodyPart = nil
    end
end

local function RaycastGround(origin, ignore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, Vector3.new(0, -80, 0), params)
    if result then return result.Position end
    return origin + Vector3.new(0, -Cfg.LegLift - 2)
end

local function SolveLeg(leg, bodyMain, ignoreList, dt)
    if not leg or not leg.Main or not leg.Main.Parent then return end

    local apexWorld = (bodyMain.CFrame * CFrame.new(leg.ApexOffset)).Position
    local rayStart = Vector3.new(
        apexWorld.X + (leg.BaseFoot.X - bodyMain.Position.X),
        apexWorld.Y + 4,
        apexWorld.Z + (leg.BaseFoot.Z - bodyMain.Position.Z)
    )
    local hitPos = RaycastGround(rayStart, ignoreList)

    if not leg.FootTarget then
        leg.FootTarget = hitPos
    end

    local distFromFoot = (hitPos - leg.FootTarget).Magnitude
    if not leg.Stepping and distFromFoot > Cfg.StepDist then
        leg.Stepping = true
        leg.StepFrom = leg.FootTarget
        leg.StepTo = hitPos
        leg.StepStart = tick()
    end

    if leg.Stepping then
        local alpha = math.clamp((tick() - leg.StepStart) / Cfg.StepSpeed, 0, 1)
        local eased = alpha * alpha * (3 - 2 * alpha)
        local pos = leg.StepFrom:Lerp(leg.StepTo, eased)
        pos = pos + Vector3.new(0, math.sin(alpha * math.pi) * Cfg.StepHeight, 0)
        leg.FootTarget = pos
        if alpha >= 1 then
            leg.Stepping = false
            leg.FootTarget = leg.StepTo
        end
    else
        leg.FootTarget = leg.FootTarget:Lerp(hitPos, math.clamp(dt * 4, 0, 1))
    end

    local foot = leg.FootTarget
    local delta = foot - apexWorld
    local dist = delta.Magnitude
    if dist < 0.01 then return end

    local maxReach = leg.Main.Size.Y * 0.98
    if dist > maxReach then
        delta = delta.Unit * maxReach
        foot = apexWorld + delta
    end

    local midPos = apexWorld + (foot - apexWorld) * 0.5
    leg.Main.CFrame = CFrame.lookAt(midPos, foot)
    leg.Main.AssemblyLinearVelocity = Vector3.zero
    leg.Main.AssemblyAngularVelocity = Vector3.zero
    SNO(leg.Main)
end

local loop = RunService.Heartbeat:Connect(function(dt)
    if not Cfg.Enabled then return end
    if not State.BodyPart or not State.BodyPart.PrimaryPart then return end

    local bodyMain = State.BodyPart.PrimaryPart
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local rootPos = root.Position
    if State.LastPos == Vector3.zero then State.LastPos = rootPos end
    State.LastPos = rootPos

    local bobY = math.sin(tick() * Cfg.BobSpeed) * Cfg.BobAmount
    local desiredBodyPos = rootPos + Vector3.new(0, Cfg.LegLift, bobY)
    local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
    local desiredBody = CFrame.lookAt(bodyMain.Position, bodyMain.Position + flatLook)

    local targetBody = CFrame.new(desiredBodyPos) * desiredBody.Rotation
    bodyMain.CFrame = bodyMain.CFrame:Lerp(targetBody, math.clamp(dt * 10, 0, 1))
    bodyMain.AssemblyLinearVelocity = Vector3.zero
    bodyMain.AssemblyAngularVelocity = Vector3.zero
    SNO(bodyMain)

    hum.PlatformStand = true
    root.CFrame = CFrame.new(rootPos) * desiredBody.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local ignoreList = { char, State.BodyPart }
    for _, pair in pairs(State.Legs) do
        for _, leg in pairs(pair) do
            if leg and leg.Part then table.insert(ignoreList, leg.Part) end
        end
    end

    for _, pair in pairs(State.Legs) do
        if pair.L then SolveLeg(pair.L, bodyMain, ignoreList, dt) end
        if pair.R then SolveLeg(pair.R, bodyMain, ignoreList, dt) end
    end
end)

local function StartSpider()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        Library:Notify({ Title = "Spider", Description = "Character not found", Time = 3 })
        return
    end

    local body = BuildBody()
    if not body or not body.PrimaryPart then
        Library:Notify({ Title = "Spider", Description = "Failed to spawn body", Time = 3 })
        return
    end

    body.PrimaryPart.CFrame = CFrame.new(root.Position + Vector3.new(0, Cfg.LegLift, 0))

    for i = 1, Cfg.LegPairs do
        BuildLegPair(i, Cfg.LegPairs, body.PrimaryPart)
        task.wait(0.1)
    end

    State.LastPos = root.Position
    Library:Notify({ Title = "Spider", Description = "Spawned " .. (Cfg.LegPairs * 2) .. " legs", Time = 3 })
end

