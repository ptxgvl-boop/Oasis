function H.teleport(subject, target, offset)
    if not subject then return false end
    local part = subject
    if typeof(subject) == "Instance" and subject:IsA("Model") then
        part = subject.PrimaryPart or subject:FindFirstChildWhichIsA("BasePart", true)
    end
    if typeof(part) ~= "Instance" or not part:IsA("BasePart") then return false end
    local targetCFrame = nil
    if typeof(target) == "CFrame" then targetCFrame = target
    elseif typeof(target) == "Vector3" then targetCFrame = CFrame.new(target)
    elseif typeof(target) == "Instance" then
        if target:IsA("BasePart") then targetCFrame = target.CFrame
        elseif target:IsA("Model") then targetCFrame = target:GetPivot() end
    end
    if not targetCFrame then return false end
    if typeof(offset) == "CFrame" then targetCFrame = targetCFrame * offset end
    part.CFrame = targetCFrame
    H.resetVelocity(part)
    return true
end

function H.ToggleCollisions(character, enabled, skipRagdollLimb, lowPhysical)
    if typeof(character) ~= "Instance" or not character:IsA("Model") then return end
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("BasePart") then
            if enabled then
                if child.Name == "Torso" or child.Name == "Head" then
                    child.CanCollide = true
                end
            else
                child.CanCollide = false
                if not skipRagdollLimb then
                    local rp = child:FindFirstChild("RagdollLimbPart")
                    if rp then rp.CanCollide = false end
                end
            end
            if child.Name ~= "HumanoidRootPart" then
                local props = lowPhysical and PhysicalProperties.new(0.01,0.01,0.01,0.01,0.01) or nil
                child.CustomPhysicalProperties = props
            end
        end
    end
