     function HideShuriken(shuriken)
        pcall(function()
            for _, v in ipairs(shuriken:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanTouch = false
                    v.CanCollide = false
                    v.CanQuery = false
                    v.Transparency = 1
                end
            end
        end)
    end

     function WaitForNewShuriken(timeout, activeCheck, existing)
        timeout = timeout or 5
        local folder = GetFolder()
        if not folder then return nil end

        local result = nil
        local conn = folder.ChildAdded:Connect(function(child)
            if child.Name == "ToolPencil" and not result and not (existing and existing[child]) then
                result = child
            end
        end)

        local start = tick()
        while not result and (tick() - start < timeout) do
            if activeCheck and not activeCheck() then
                conn:Disconnect()
                return nil
            end
            task.wait()
        end
        conn:Disconnect()
        return result
    end

