                for _, v in pairs(wingData)do
                    if v and v.Handle then
                        v.Handle:Destroy()
                    end
                    if v and v.Segments then
                        for _, seg in pairs(v.Segments)do
                            if seg then
                                seg:Destroy()
                            end
                        end
                    end
                end

                wingData = {}
            else
                rebuildWings()

                local folders = getAllPalletFolders()

                for _, folder in pairs(folders)do
                    watchFolder(folder)
                end
            end
        end,
    })
