    task.wait(0.05)

    local uptL = SessionBox:AddLabel(Row('Uptime', '0s'))
    local start = tick()
    local last = -1

    RunService.Heartbeat:Connect(function()
        local s = math.floor(tick() - start)

        if s ~= last then
            last = s
            uptL:SetText(Row('Uptime', FormatUptime(s)))
        end
    end)
    task.wait(0.09)

    local fpsL = SessionBox:AddLabel(Row('FPS', '\u{2014}'))
