getgenv().handleDecoy = function(d, isServer)
    if not isServer and currentDecoy and currentDecoy.Parent then return end
    if isServer and currentServerDecoy and currentServerDecoy.Parent then return end

    local partName = toyMap[d.Name]
    if not partName then return end

    local toyPart = d:WaitForChild(partName)
    local pivotCF = d:GetPivot()

    rs.GrabEvents.SetNetworkOwner:FireServer(toyPart, pivotCF)
    task.wait(0.09)

    local startTime = tick()
    local success = false
    local connection

    connection = RunService.Heartbeat:Connect(function()
        local tag = toyPart:FindFirstChild('PartOwner')
        if tag and tag:IsA('StringValue') and tag.Value == lp.Name then
            success = true
            connection:Disconnect()

            local uniqueAttr = isServer and SERVER_UNIQUE_ATTRIBUTE or UNIQUE_ATTRIBUTE

            if not d:GetAttribute(uniqueAttr) then
                d:SetAttribute(uniqueAttr, true)

                if isServer then
                    currentServerDecoy = d
                    monitorOwnership(d, toyPart, true)
                    if isServerEnabled then
                        setupServerFling(d)
                    end
                else
                    currentDecoy = d
                    monitorOwnership(d, toyPart, false)
                    if isEnabled then
                        setupFling(d)
                    end
                end
            end
        end
        if tick() - startTime >= 3 and not success then
            rs.MenuToys.DestroyToy:FireServer(d)
            connection:Disconnect()
        end
    end)
end

