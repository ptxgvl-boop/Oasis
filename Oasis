local function handleCounterAttackChild(child, localRoot)
    if not child:IsA("StringValue") or child.Name ~= "PartOwner" then return end
    local player = Def_Players:FindFirstChild(child.Value)
    if not player then return end
    defState.WhoGrabbed = H.FormatPlayer(player)
    if not runtimeFlags.CounterAttack or defState.Whitelisted[player] then return end
    local _, targetRoot = H.charp(player)
    if defSettings.CounterMethod == "Kill" then H.kill(player)
    elseif defSettings.CounterMethod == "Void" then H.void(player)
    elseif defSettings.CounterMethod == "Grab" then H.grab(targetRoot)
    elseif defSettings.CounterMethod == "Delete Limbs" then H.breaklimb(player, defSettings.TargetedLimbCA)
    elseif defSettings.CounterMethod == "Fling" then
        if targetRoot and localRoot and H.sno(targetRoot) then
            targetRoot.Velocity = localRoot.CFrame.LookVector * 100 + Vector3.new(0, 25, 0)
        end
    elseif defSettings.CounterMethod == "Teleport to Spawn" then
        if targetRoot and H.sno(targetRoot) then
            H.teleport(targetRoot, CFrame.new(0, 10, 0))
        end
    end
end

local function bindCounterAttack(character)
    local _, rootPart = H.charp()
    local head = character and character:FindFirstChild("Head")
    if not head then return end
    if activeConnections.CounterAttack then activeConnections.CounterAttack:Disconnect() end
    activeConnections.CounterAttack = head.ChildAdded:Connect(function(child)
        handleCounterAttackChild(child, rootPart)
    end)
end

