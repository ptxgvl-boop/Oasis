 function GetTriggerTarget()
    if not AimConfig.TriggerEnabled then return nil end
    if UserInputService:GetFocusedTextBox() then return nil end
    if Workspace:FindFirstChild("GrabParts") then return nil end

    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local camPos = Camera.CFrame.Position
    local ray = Camera:ViewportPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    AimRayParams.FilterDescendantsInstances = {char}
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 1000, AimRayParams)
    if not hit or not hit.Instance then return nil end

    local model = hit.Instance:FindFirstAncestorOfClass("Model")
    if not model then return nil end

    local plr = Players:GetPlayerFromCharacter(model)
    if not plr or plr == LocalPlayer then return nil end
    if IsWL(plr) and not AimConfig.IgnoreWhitelist then return nil end

    local hrp = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return nil end

    if (hrp.Position - myRoot.Position).Magnitude > AimConfig.TriggerDist then return nil end

    return plr
end

 function PlayTriggerTrick(version, target)
    if not AimConfig.TriggerTricks then return true end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum    = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not hum then return false end

    local tChar = target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return false end

    local savedCF = Camera.CFrame
    local savedCamType = Camera.CameraType
    local savedRot = myRoot.CFrame.Rotation
    local savedPos = myRoot.Position

    local spins = (AimConfig.TrickType == "720 Spin") and 2 or 1
    local duration = 0.175 * spins / math.clamp(AimConfig.TrickSpeed, 0.75, 2)
    local elapsed = 0

    AimState.TriggerSpinning = true

    local ok = pcall(function()
        Camera.CameraType = Enum.CameraType.Scriptable

        repeat
            local dt = RunService.RenderStepped:Wait()
            elapsed = elapsed + dt

            if AimState.TriggerVersion ~= version or not AimConfig.TriggerEnabled then
                return false
            end

            local alpha = math.min(elapsed / duration, 1)
            local angle
            if AimConfig.TrickType == "180 Flick" then
                angle = math.sin(alpha * math.pi) * math.pi
            else
                angle = alpha * math.pi * 2 * spins
            end

            local baseLook = CFrame.new(savedPos, tRoot.Position)
            Camera.CFrame = CFrame.new(savedPos) * CFrame.Angles(0, angle, 0) * baseLook.Rotation

            local lookXZ = Camera.CFrame.LookVector * Vector3.new(1, 0, 1)
            if lookXZ.Magnitude > 0.001 then
                myRoot.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + lookXZ)
            end
        until elapsed >= duration

        return true
    end)

    AimState.TriggerSpinning = false

    if myRoot.Parent then
        myRoot.CFrame = CFrame.new(myRoot.Position) * savedRot
    end
    if Camera.Parent then
        Camera.CFrame = savedCF + myRoot.Position - savedPos
        Camera.CameraType = savedCamType
    end

    return ok
end

