    local function sno(part)
        if part then
            pcall(function()
                SetNetworkOwner:FireServer(part, part.CFrame)
            end)
        end
    end

    local function spawntoy(toy, cf)
        if not LocalPlayer:FindFirstChild('CanSpawnToy') then return nil end
        if not LocalPlayer.CanSpawnToy.Value then
            LocalPlayer.CanSpawnToy.Changed:Wait()
        end

        local inv = Workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
        if not inv then return nil end

        local t
        local conn = inv.ChildAdded:Connect(function(c)
            if c.Name == toy then
                t = c
                conn:Disconnect()
            end
        end)

        task.spawn(function()
            pcall(function()
                SpawnToyRemote:InvokeServer(toy, cf, Vector3.zero)
            end)
        end)

        local timeout = tick() + 1
        repeat task.wait() until t or tick() > timeout

        if conn then conn:Disconnect() end
        return t
    end

    local function spawnragdoll()
        local char = LocalPlayer.Character
        local HRP = char and char:FindFirstChild('HumanoidRootPart')
        if not HRP then return end

        PalletForRagdoll = spawntoy('PalletLightBrown', HRP.CFrame * CFrame.new(0, 10, 20))
        if not PalletForRagdoll then return end

        repeat task.wait() until PalletForRagdoll and PalletForRagdoll:FindFirstChild('SoundPart')
        repeat
            task.wait()
            sno(PalletForRagdoll.SoundPart)
        until PalletForRagdoll.SoundPart:FindFirstChild('PartOwner')

        PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1e9, 0)

        for _, v in pairs(PalletForRagdoll:GetChildren()) do
            if v:IsA('Part') then
                v.CanCollide = false
                v.CanQuery = false
                v.Transparency = 1
            end
        end

        PalletForRagdoll.Name = 'PalletForRagdoll'

        cons.PalletDestroying = PalletForRagdoll.Destroying:Once(function()
            if loopragdoll and ragdollMode == 'Pallet' then
                spawnragdoll()
            end
        end)
    end

    local function cleanupPallet()
        if cons.PalletDestroying then
            cons.PalletDestroying:Disconnect()
            cons.PalletDestroying = nil
        end

        local inv = Workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
        if inv and inv:FindFirstChild('PalletForRagdoll') then
            pcall(function()
                DestroyToy:FireServer(inv.PalletForRagdoll)
            end)
        end

        PalletForRagdoll = nil
    end

    local function cleanupBlackhole()
        if blackholeTask then
            pcall(function() task.cancel(blackholeTask) end)
            blackholeTask = nil
        end

        if currentBomb and currentBomb.Parent then
            pcall(function()
                DestroyToy:FireServer(currentBomb)
            end)
        end

        currentBomb = nil
    end

    local function startPalletMode()
        if ragdollTask then
            pcall(function() task.cancel(ragdollTask) end)
            ragdollTask = nil
        end

        spawnragdoll()

        ragdollTask = task.spawn(function()
            while loopragdoll and ragdollMode == 'Pallet' do
                task.wait(0.05)

                if not SelectedTarget or not SelectedTarget.Parent then
                    continue
                end

                local tChar = SelectedTarget.Character
                if tChar and tChar:FindFirstChild('Humanoid') and tChar.Humanoid.Ragdolled and not tChar.Humanoid.Ragdolled.Value then
                    if PalletForRagdoll and PalletForRagdoll:FindFirstChild('SoundPart') then
                        local tRoot = tChar:FindFirstChild('HumanoidRootPart')
                        if tRoot then
                            PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                            PalletForRagdoll.SoundPart.CFrame = tRoot.CFrame
                            task.wait(0.05)
                            PalletForRagdoll.SoundPart.CFrame = CFrame.new(0, 1e9, 0)
                        end
                    end
                end
            end
        end)
    end

    local function startBlackholeMode()
        if blackholeTask then
            pcall(function() task.cancel(blackholeTask) end)
            blackholeTask = nil
        end

        blackholeTask = task.spawn(function()
            while loopragdoll and ragdollMode == 'Blackhole' do
                if not SelectedTarget or not SelectedTarget.Parent then
                    task.wait(0.2)
                    continue
                end

                local tChar = SelectedTarget.Character
                if not tChar then
                    task.wait(0.2)
                    continue
                end

                local tRoot = tChar:FindFirstChild('HumanoidRootPart')
                if not tRoot then
                    task.wait(0.2)
                    continue
                end

                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild('HumanoidRootPart')
                if not hrp then
                    task.wait(0.2)
                    continue
                end

                if currentBomb and currentBomb.Parent then
                    pcall(function()
                        DestroyToy:FireServer(currentBomb)
                    end)
                    currentBomb = nil
                end

                local bomb = spawntoy('BombDarkMatter', hrp.CFrame * CFrame.new(0, 10, 15))
                if not bomb then
                    task.wait(0.2)
                    continue
                end

                currentBomb = bomb

                local hitbox = bomb:FindFirstChild('PartHitDetector') or bomb:FindFirstChild('Pyramid')
                if hitbox then
                    sno(hitbox)
                end

                local bodyPart = bomb.PrimaryPart or bomb:FindFirstChild('Pyramid') or bomb:FindFirstChildWhichIsA('BasePart')
                if bodyPart then
                    bodyPart.CanCollide = false
                    bodyPart.CanQuery = false
                end

                task.wait(0.05)

                if bomb and bomb.Parent and tRoot and tRoot.Parent then
                    local hitbox2 = bomb:FindFirstChild('PartHitDetector')
                    if hitbox2 then
                        pcall(function()
                            BombEvents.BombExplode:FireServer({
                                Hitbox = hitbox2,
                                PositionPart = tRoot,
                            }, tRoot.Position)
                        end)
                    end
                end

                task.wait(0.05)

                if currentBomb and currentBomb.Parent then
                    pcall(function()
                        DestroyToy:FireServer(currentBomb)
                    end)
                    currentBomb = nil
                end

                task.wait(0.15)
            end
        end)
    end

    local function stopAll()
        if ragdollTask then
            pcall(function() task.cancel(ragdollTask) end)
            ragdollTask = nil
        end

        cleanupPallet()
        cleanupBlackhole()
    end

    SettingsKick:AddDropdown('RagdollModeSelect', {
        Text = 'Ragdoll Mode',
        Values = { 'Pallet', 'Blackhole' },
        Default = 'Pallet',
        Multi = false,
        ValueImages = {
            Pallet = 'box',
            Blackhole = 'atom',
        },
        Callback = function(Value)
            ragdollMode = Value

            if loopragdoll then
                stopAll()
                task.wait(0.1)

                if Value == 'Pallet' then
                    startPalletMode()
                elseif Value == 'Blackhole' then
                    startBlackholeMode()
                end
            end
        end,
    })

    SettingsKick:AddCheckbox('LoopRagdoll', {
        Text = 'Ragdoll Target',
        Default = false,
        Callback = function(enabled)
            loopragdoll = enabled

            if enabled then
                if not SelectedTarget then
                    Library:Notify({
                        Title = 'PredatorX',
                        Description = 'Select a target first!',
                        Icon = 'rbxassetid://116176143011396',
                        Duration = 3
                    })
                    task.wait(0.1)
                    Toggles.LoopRagdoll:SetValue(false)
                    return
                end

                if ragdollMode == 'Pallet' then
                    startPalletMode()
                elseif ragdollMode == 'Blackhole' then
                    startBlackholeMode()
                end
            else
                stopAll()
            end
        end,
    })
end

function RemoveAntiKickFunction()
    SetNetOwner = ReplicatedStorage.GrabEvents.SetNetworkOwner
    LocalPlayer = game.Players.LocalPlayer

    function invis_touch(part, cf)
        SetNetOwner:FireServer(part, cf)
    end

    function CheckAndYeet(toy)
        part = toy:FindFirstChild("SoundPart")
        if part then
            invis_touch(part, part.CFrame)
            if part:FindFirstChild("PartOwner") and part.PartOwner.Value == LocalPlayer.Name then
                part.CFrame = CFrame.new(0, 1000, 0)
            end
        end
    end

    while antiAntiKickActive do
        local target = SelectedTarget

        if target and target.Parent then
            spawned = workspace:FindFirstChild(target.Name .. "SpawnedInToys")
            if spawned then
                if spawned:FindFirstChild("NinjaKunai") then
                    CheckAndYeet(spawned.NinjaKunai)
                end
                if spawned:FindFirstChild("NinjaShuriken") then
                    CheckAndYeet(spawned.NinjaShuriken)
                end
                if spawned:FindFirstChild("AntiKick") then
                    CheckAndYeet(spawned.AntiKick)
                end
                if spawned:FindFirstChild("ToolCleaver") then
                    CheckAndYeet(spawned.ToolCleaver)
                end
                if spawned:FindFirstChild("ToolPencil") then
                    CheckAndYeet(spawned.ToolPencil)
                end
                if spawned:FindFirstChild("ToolPickaxe") then
                    CheckAndYeet(spawned.ToolPickaxe)
                end
                if spawned:FindFirstChild("NinjaKatana") then
                    CheckAndYeet(spawned.NinjaKatana)
                end
                if spawned:FindFirstChild("ToolDiggingForkRusty") then
                    CheckAndYeet(spawned.ToolDiggingForkRusty)
                end
            end
        end

        task.wait(0.1)
    end
end

