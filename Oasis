local BananaRagdollEnabled = false
local LoopSnowballEnabled = false

local function bananaRagdollLoop()
    while BananaRagdollEnabled do
        if char then
            local hrp, humanoid = GetHRH(char)

            if hrp and humanoid and humanoid.Health > 0 then
                local FoodBanana = NewToy("FoodBanana", hrp.CFrame * CFrame.new(0, 15, 20))

                if FoodBanana then
                    FoodBanana.Name = "BananaRagdoll"

                    task.spawn(function()
                        if FoodBanana.Parent == toysFolder then
                            local foodBanana = LocalPlayer.PlayerGui.MenuGui.Menu.TabContents.ToyDestroy.Contents
                                :WaitForChild("FoodBanana", 1)

                            if foodBanana then
                                foodBanana.Name = "BananaRagdoll"
                                foodBanana.ViewItemButton.Season.Visible = true
                                foodBanana.ViewItemButton.Season.Text = "Banana Ragdoll"
                            end
                        end
                    end)

                    local soundPart = FoodBanana:WaitForChild("SoundPart", 1)
                    local holdPart = FoodBanana:WaitForChild("HoldPart", 1)

                    if soundPart and holdPart then
                        local holdItemRemoteFunction = holdPart:WaitForChild("HoldItemRemoteFunction", 1)
                        local dropItemRemoteFunction = holdPart:WaitForChild("DropItemRemoteFunction", 1)
                        local rigidConstraint = holdPart:WaitForChild("RigidConstraint", 1)

                        if holdItemRemoteFunction and dropItemRemoteFunction and rigidConstraint then
                            local startTime = tick()

                            while true do
                                task.wait()

                                pcall(function()
                                    holdItemRemoteFunction:InvokeServer(FoodBanana, char)
                                end)

                                local attach1 = rigidConstraint.Attachment1
                                local attachParent = attach1 and attach1.Parent
                                local attachOwner = attachParent and attachParent.Parent

                                local shouldBreak = not BananaRagdollEnabled
                                    or not hrp
                                    or not humanoid
                                    or humanoid.Health <= 0
                                    or not FoodBanana
                                    or not holdItemRemoteFunction
                                    or not rigidConstraint
                                    or (attachOwner and attachOwner.Name == LocalPlayer.Name)
                                    or tick() - startTime > 3

                                if shouldBreak then
                                    break
                                end
                            end

                            local attach1 = rigidConstraint and rigidConstraint.Attachment1
                            local attachParent = attach1 and attach1.Parent
                            local attachOwner = attachParent and attachParent.Parent

                            if rigidConstraint
                                and attach1
                                and attachParent
                                and attachOwner
                                and attachOwner.Name == LocalPlayer.Name
                            then
                                ReplicatedStorage.HoldEvents.Use:FireServer(FoodBanana)

                                while true do
                                    task.wait()

                                    if not FoodBanana or not FoodBanana:FindFirstChild("EdiblePart") then
                                        break
                                    end
                                end

                                pcall(function()
                                    dropItemRemoteFunction:InvokeServer(FoodBanana)
                                end)

                                local ownerStart = tick()
                                local owner = nil

                                while true do
                                    task.wait()
                                    owner = Ownerboat(soundPart)

                                    if not BananaRagdollEnabled
                                        or not soundPart
                                        or not hrp
                                        or not humanoid
                                        or humanoid.Health <= 0
                                        or (hrp.Position - soundPart.Position).Magnitude > 20
                                        or tick() - ownerStart > 3
                                        or owner
                                    then
                                        break
                                    end
                                end

                                if owner then
                                    soundPart.CanCollide = false

                                    local highlight = Instance.new("Highlight", FoodBanana)
                                    highlight.FillColor = Color3.fromRGB(0, 0, 0)
                                    highlight.OutlineColor = Color3.new(255, 255, 255)

                                    local billboardGui = Instance.new("BillboardGui", FoodBanana)
                                    billboardGui.AlwaysOnTop = true
                                    billboardGui.Size = UDim2.new(5, 50, 1, 50)

                                    local textLabel = Instance.new("TextLabel", billboardGui)
                                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                                    textLabel.TextColor3 = Color3.new(255, 255, 255)
                                    textLabel.TextStrokeTransparency = 0
                                    textLabel.BackgroundTransparency = 1
                                    textLabel.Text = "Banana Ragdoll"

                                    UnGrab(soundPart)

                                    while true do
                                        task.wait()

                                        if not BananaRagdollEnabled
                                            or not soundPart
                                            or not soundPart:FindFirstChild("PartOwner")
                                        then
                                            break
                                        end
                                    end

                                    while BananaRagdollEnabled
                                        and task.wait()
                                        and soundPart
                                        and soundPart.Parent
                                        and not soundPart:FindFirstChild("PartOwner")
                                    do
                                        Teleport(
                                            soundPart,
                                            workspace.SpawnLocation.CFrame,
                                            CFrame.new(
                                                math.random(-6767, 6767),
                                                6767,
                                                math.random(-6767, 6767)
                                            )
                                        )

                                        for _, targetPlayer in pairs(AllTargets) do
                                            if targetPlayer.Character then
                                                local targetHRP, targetHumanoid = GetHRH(targetPlayer.Character)

                                                if targetHRP
                                                    and targetHumanoid
                                                    and targetHumanoid.Health > 0
                                                    and (targetPlayer.Character:FindFirstChild("Left Leg")
                                                        or targetPlayer.Character:FindFirstChild("Right Leg"))
                                                then
                                                    Teleport(soundPart, targetHRP.CFrame, CFrame.new(0, -1.5, 0))
                                                    task.wait(0.1)

                                                    Teleport(
                                                        soundPart,
                                                        workspace.SpawnLocation.CFrame,
                                                        CFrame.new(
                                                            math.random(-6767, 6767),
                                                            6767,
                                                            math.random(-6767, 6767)
                                                        )
                                                    )
                                                    task.wait(0.05)
                                                end
                                            end
                                        end
                                    end

                                    DestroyT(FoodBanana)
                                else
                                    DestroyT(FoodBanana)
                                end
                            else
                                DestroyT(FoodBanana)
                            end
                        else
                            DestroyT(FoodBanana)
                        end
                    else
                        DestroyT(FoodBanana)
                    end
                end
            end
        end

        task.wait()
    end
end

local function loopSnowballLoop()
    while LoopSnowballEnabled do
        RunService.RenderStepped:Wait()

        local targetPlayer = GetFirstTarget()

        if targetPlayer and targetPlayer.Character then
            local hrp = char:WaitForChild("HumanoidRootPart", 1)
            local targetHRP = targetPlayer.Character:WaitForChild("HumanoidRootPart", 1)
            local targetHumanoid = targetPlayer.Character:WaitForChild("Humanoid", 1)

            if hrp and targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
                for _, toy in pairs(toysFolder:GetChildren()) do
                    if toy.Name == "BallSnowball" then
                        toy.Name = "deleted_snowball"
                        DestroyT(toy)
                    end
                end

                while true do
                    RunService.RenderStepped:Wait()

                    if LocalPlayer.CanSpawnToy.Value == true or not LoopSnowballEnabled then
                        break
                    end
                end

                if not LoopSnowballEnabled then
                    break
                end

                SpawnToy(
                    "BallSnowball",
                    CFrame.new(hrp.Position + Vector3.new(-3, 10, 15))
                )

                local hasPlot, plotFolder = GetPlot()
                local ballSnowball

                if hasPlot and plotFolder then
                    ballSnowball = plotFolder:WaitForChild("BallSnowball", 1)
                else
                    ballSnowball = toysFolder:WaitForChild("BallSnowball", 1)
                end

                if ballSnowball then
                    local soundPart = ballSnowball:WaitForChild("SoundPart", 1)

                    if soundPart then
                        local ownerStart = tick()

                        while true do
                            SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
                            RunService.RenderStepped:Wait()

                            local partOwner = soundPart:FindFirstChild("PartOwner")
                            local isOwner = partOwner and partOwner.Value == LocalPlayer.Name
                            local timedOut = tick() - ownerStart > 0.5

                            if isOwner or not LoopSnowballEnabled or not ballSnowball or not soundPart or timedOut then
                                break
                            end
                        end

                        if targetHRP
                            and targetHumanoid
                            and targetHumanoid.Health >= 0
                            and hrp
                        then
                            local bodyVelocity = Instance.new("BodyVelocity", soundPart)
                            bodyVelocity.Velocity = Vector3.new(0, 250, 0)
                        end

                        local touchStart = tick()

                        repeat
                            task.wait(0.01)
                            firetouchinterest(soundPart, targetHRP, 0)
                        until tick() - touchStart > 0.5 or not LoopSnowballEnabled
                    end
                end
            end
        end
    end
end

