-- AntiGrab
local antiGrabConnection = nil
local antiGrabSavedCFrame = nil

local function stopAntiGrab()
    if antiGrabConnection then
        antiGrabConnection:Disconnect()
        antiGrabConnection = nil
    end
    defState.States["Anti Grab"] = false
    local _, _, humanoid = H.charp()
    if humanoid then
        if defSettings.AGType == "Anti-Kill" then
            task.delay(0.1, function()
                if humanoid.Parent then humanoid.Sit = false end
            end)
        end
        humanoid.AutoRotate = true
    end
end

local function startAntiGrabIfNeeded()
    if not runtimeFlags.AntiGrab or not _IsHeld.Value or defState.States["Anti Grab"] then return end
    refreshRemotes()
    if remotes.Struggle then remotes.Struggle:FireServer() end
    local character, rootPart, humanoid = H.charp()
    local torso = character and character:FindFirstChild("Torso")
    local neck = torso and torso:FindFirstChild("Neck")
    if not humanoid or not torso then return end
    humanoid.RequiresNeck = false
    H.resetVelocity(rootPart or torso)
    antiGrabSavedCFrame = torso.CFrame
    defState.States["Anti Grab"] = true
    local buggy = defSettings.AGType == "Escapes-Anything-but-buggy"
    local antiKill = defSettings.AGType == "Anti-Kill"
    local noRagdoll = defSettings.AGType == "No-Ragdoll"

    antiGrabConnection = Def_RunService.Heartbeat:Connect(function(dt)
        if remotes.Struggle then remotes.Struggle:FireServer() end
        if rootPart and not buggy and not noRagdoll and remotes.RagdollRemote then
            remotes.RagdollRemote:FireServer(rootPart, antiKill and 0.11 or 0)
        end
        local moveDirection = humanoid.MoveDirection
        local speed = humanoid.WalkSpeed > 16 and humanoid.WalkSpeed or 16
        if moveDirection.Magnitude > 0 then
            antiGrabSavedCFrame = antiGrabSavedCFrame + (moveDirection.Unit * speed * dt)
            local horizontal = Vector3.new(moveDirection.X, 0, moveDirection.Z)
            if horizontal.Magnitude > 0 then
                local position = antiGrabSavedCFrame.Position
                local look = CFrame.lookAt(position, position + horizontal.Unit)
                antiGrabSavedCFrame = antiGrabSavedCFrame:Lerp(look, 0.12)
            end
        end
        H.resetVelocity(rootPart or torso)
        torso.CFrame = antiGrabSavedCFrame
        humanoid.Sit = antiKill
        task.spawn(H.ToggleCollisions, character, false)
        if not neck or not neck.Enabled then
            task.spawn(H.RepositionLimbs, character)
        end
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            local animation = track.Animation
            if animation and animation.AnimationId == "rbxassetid://7047322890" then
                track:Stop()
            end
        end
        if rootPart then
            local scream = rootPart:FindFirstChild("Scream")
            if scream then scream.Playing = false end
        end
        if not _IsHeld.Value or not runtimeFlags.AntiGrab then
            defState.States["Anti Grab"] = false
            if antiKill then
                task.delay(0.1, function()
                    if humanoid.Parent then humanoid.Sit = false end
                end)
            end
            humanoid.AutoRotate = true
            if antiGrabConnection then
                antiGrabConnection:Disconnect()
                antiGrabConnection = nil
            end
        end
    end)
end

task.spawn(function()
    while task.wait(0.03) do
        if runtimeFlags.AntiGrab then
            startAntiGrabIfNeeded()
        elseif defState.States["Anti Grab"] then
            stopAntiGrab()
        end
    end
end)

-- Gucci AntiGrab
local gucciWorkerGeneration = 0
local gucciActiveCleanup = nil

local function stopGucciAntiGrab()
    gucciWorkerGeneration += 1
    if gucciActiveCleanup then
        local cleanup = gucciActiveCleanup
        gucciActiveCleanup = nil
        pcall(cleanup)
    end
end

local function runGucciAntiGrab()
    gucciWorkerGeneration += 1
    local generation = gucciWorkerGeneration
    local vehicle = nil
    local seat = nil
    local nicePart = nil
    local vehicleType = nil
    local descendantConnection = nil
    local respawned = false

    local function cleanup()
        if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
        if vehicle then H.dt(vehicle) vehicle = nil end
        seat = nil; nicePart = nil; vehicleType = nil
    end
    gucciActiveCleanup = cleanup

    local function waitTypeChange(expected)
        repeat task.wait() until defSettings.GucciType ~= expected
            or not runtimeFlags.GucciAntiGrab
            or generation ~= gucciWorkerGeneration
    end

    local function hideDescendant(descendant)
        if descendant:IsA("BasePart") then
            descendant.Transparency = 1
            descendant.CanCollide = false
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            descendant.Transparency = 1
        elseif descendant.Name == "ItemSpawnSound" then
            descendant:Destroy()
        end
    end

    while runtimeFlags.GucciAntiGrab and generation == gucciWorkerGeneration and task.wait() do
        local character, rootPart, humanoid = H.charp()
        if not humanoid or humanoid.Health == 0 then
            Def_LocalPlayer.CharacterAdded:Wait()
            respawned = true
            task.delay(1, function() respawned = false end)
            task.wait(0.16)
            continue
        end
        local ragdolled = humanoid:FindFirstChild("Ragdolled")
        if not rootPart or not ragdolled or _IsHeld.Value or ragdolled.Value or humanoid.Health <= 0 then continue end
        if humanoid.Sit then humanoid.Sit = false end

        local currentType = defSettings.GucciType
        local reusable = false
        if vehicle and vehicle.Parent and seat and seat.Parent and vehicleType == currentType then
            local occ = seat.Occupant
            if occ == nil or occ == humanoid then reusable = true end
        end

        if not reusable then
            cleanup()
            if currentType == "Train" then
                local map = Def_Workspace:FindFirstChild("Map")
                local always = map and map:FindFirstChild("AlwaysHereTweenedObjects")
                local train = always and always:FindFirstChild("Train")
                local object = train and train:FindFirstChild("Object")
                local objectModel = object and object:FindFirstChild("ObjectModel")
                if not objectModel then
                    pcall(function() Library:Notify({Title="Gucci", Description="Train doesn't exist!",Icon = "rbxassetid://116176143011396", Time=3}) end)
                    waitTypeChange(currentType); continue
                end
                vehicle = objectModel
                seat = vehicle:FindFirstChildWhichIsA("Seat")
                nicePart = nil
                vehicleType = currentType
                if not seat then
                    pcall(function() Library:Notify({Title="Gucci", Description="Train has no seats!",Icon = "rbxassetid://116176143011396", Time=3}) end)
                    waitTypeChange(currentType); cleanup(); continue
                end
            else
                refreshRemotes()
                if not remotes.spawnEvent then continue end
                pcall(function()
                    remotes.spawnEvent:InvokeServer(currentType, CFrame.new(100000, 500000, 0), Vector3.zero)
                end)
                task.wait(0.2)
                local folder = Def_Workspace:FindFirstChild(Def_LocalPlayer.Name .. "SpawnedInToys")
                vehicle = folder and folder:FindFirstChild(currentType)
                seat = vehicle and vehicle:WaitForChild("VehicleSeat", 1.25)
                nicePart = seat and H.findNicePart(vehicle) or nil
                vehicleType = currentType
                if vehicle then
                    for _, descendant in pairs(vehicle:GetDescendants()) do hideDescendant(descendant) end
                    descendantConnection = vehicle.DescendantAdded:Connect(hideDescendant)
                end
                if not seat then cleanup() continue end
            end
        end

        local currentVehicle = vehicle
        local currentSeat = seat
        local currentNicePart = nicePart
        local active = true

        if currentNicePart then
            local oldBP = currentNicePart:FindFirstChild("GucciBP")
            if oldBP then oldBP:Destroy() end
        end
        currentSeat.Transparency = 1
        currentSeat.CanCollide = false

        local seatWeldBroken = false
        local savedCFrame = rootPart.CFrame
        local started = tick()

        currentSeat.ChildAdded:Once(function(child)
            if child.Name == "SeatWeld" then
                child.Enabled = false
                child:Destroy()
                seatWeldBroken = true
            end
        end)

        refreshRemotes()
        task.defer(function()
            while humanoid and humanoid.Health > 0 and active and task.wait() do
                if remotes.RagdollRemote then remotes.RagdollRemote:FireServer(rootPart, 0) end
            end
        end)
        task.wait(0.1)

        currentSeat:Sit(humanoid)

        while true do
            task.wait()
            if humanoid.Health <= 0 or not rootPart.Parent or not currentVehicle.Parent or not currentSeat.Parent then break end
            if _IsHeld.Value or ragdolled.Value or seatWeldBroken or tick() - started > 0.75 then break end
        end

        if seatWeldBroken then
            humanoid.Sit = false
            task.delay(0.15, function()
                active = false
                task.wait()
                if remotes.RagdollRemote and rootPart.Parent then remotes.RagdollRemote:FireServer(rootPart, 0.15) end
            end)
            if respawned then H.teleport(rootPart, savedCFrame) end
            if defSettings.GucciType ~= "Train" and currentNicePart then
                local plotItems = Def_Workspace:FindFirstChild("PlotItems")
                local inPlotItems = plotItems and currentNicePart:IsDescendantOf(plotItems)
                if inPlotItems or H.isnetworkowner(currentNicePart) or H.sno(currentNicePart) then
                    local position = Vector3.new(math.random(-100000,100000), 100000, math.random(-100000,100000))
                    local bodyPosition = Instance.new("BodyPosition")
                    bodyPosition.Name = "GucciBP"
                    bodyPosition.D = 200
                    bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyPosition.Position = position
                    currentVehicle.Name = "GucciRSC"
                    bodyPosition.Parent = currentNicePart
                end
            end
            task.delay(0.75, function()
                if not currentSeat or not currentSeat.Parent or not currentVehicle or not currentVehicle.Parent then return end
                currentSeat.Parent = Def_Replicated
                task.wait()
                if humanoid and humanoid.Parent then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                end
                if currentVehicle and currentVehicle.Parent and currentSeat then
                    currentSeat.Parent = currentVehicle
                end
            end)
            while currentVehicle.Parent and currentSeat.Parent and humanoid.Parent and humanoid.Health > 0
                and not _IsHeld.Value and not ragdolled.Value
                and (currentSeat.Occupant == nil or currentSeat.Occupant == humanoid)
                and runtimeFlags.GucciAntiGrab and defSettings.GucciType == currentType
                and generation == gucciWorkerGeneration
            do task.wait() end
            local occ = currentSeat.Occupant
            if occ and occ ~= humanoid and occ.Parent then
                local plr = Def_Players:FindFirstChild(occ.Parent.Name)
                if plr then
                    pcall(function() Library:Notify({Title="Gucci", Description=plr.DisplayName.." sat on your gucci!",Icon = "rbxassetid://116176143011396", Time=3}) end)
                end
            end
            if humanoid and humanoid.Parent and humanoid.Health > 0 then
                local occupiedSeat = humanoid.SeatPart
                if occupiedSeat and occupiedSeat ~= currentSeat then
                    pcall(function() Library:Notify({Title="Gucci", Description="You can't sit on other Vehicles while in Gucci!", Time=3}) end)
                end
                humanoid.Sit = true
                task.wait(0.05)
                humanoid.Sit = false
                task.wait(0.05)
            end
        end

        if descendantConnection then descendantConnection:Disconnect() descendantConnection = nil end
        if currentVehicle and currentVehicle.Parent then H.dt(currentVehicle) end
        vehicle = nil; seat = nil; nicePart = nil; vehicleType = nil; active = false
        task.wait(0.05)
    end
    cleanup()
    if gucciActiveCleanup == cleanup then gucciActiveCleanup = nil end
end

