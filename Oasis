 function onPossibleKickFlag(firstArg)
    if firstArg ~= "Flying" then return end
    local timestamp = tick()
    if timestamp - defState.LastKickFlagTime <= 1 then
        defState.KickFlags += 1
    else
        defState.LastKickFlagTime = timestamp
        defState.KickFlags = 1
    end
    if not runtimeFlags.AutoReset then return end
    if defState.KickFlags < 4 then
        local _, _, humanoid = H.charp()
        if humanoid then
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
                humanoid:ChangeState(Enum.HumanoidStateType.Dead)
            end)
            if defState.KickFlags == 1 then
                pcall(function() Library:Notify({Title="Auto Reset", Description="Reset due to kick flag", Time=3}) end)
            end
        end
    else
        Def_LocalPlayer:Kick("PredatorX Auto Reset/Avoied kicks")
    end
end

