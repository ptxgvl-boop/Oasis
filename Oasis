        local name = target.Name
        PrXFlingActive[name] = false
        if PrXFlingThread[name] then
            pcall(function() task.cancel(PrXFlingThread[name]) end)
            PrXFlingThread[name] = nil
        end
        if PrXFlingBAV[name] then
            pcall(function() PrXFlingBAV[name]:Destroy() end)
