function DodgeCast(originPos, dirVec)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character }

    local result = Workspace:Raycast(originPos, dirVec * MISSILE_DETECT_RANGE, rayParams)
    if result and result.Instance then
        return result
    end
    return nil
end

function ComputeDodgeDirection(bombPart, targetPos, index, total)
    local currentPos = bombPart.Position
    local toTarget = (targetPos - currentPos)
    local dist = toTarget.Magnitude
    if dist < 0.01 then return Vector3.zero end
    local dir = toTarget.Unit

    local hit = DodgeCast(currentPos, dir)
    if not hit then return dir end

    local hitNormal = hit.Normal
    local side = (index % 2 == 0) and 1 or -1
    local rollAxis = dir:Cross(Vector3.new(0, 1, 0))
    if rollAxis.Magnitude < 0.01 then
        rollAxis = Vector3.new(1, 0, 0)
    end
    rollAxis = rollAxis.Unit * side

    local dodgeDir = (dir * 0.6 + rollAxis * 0.8 + hitNormal * 0.3).Unit
    return dodgeDir
end

function StartMissileMode(bomb, targetPlayer, index, total)
    if not bomb or not bomb.PrimaryPart then return end
    if not targetPlayer then return end

    index = index or 1
    total = total or 1

    local mainPart = bomb.PrimaryPart
    local hitPart = bomb:FindFirstChild(SetupParts[bomb.Name])
    if hitPart then
        SetNetworkOwnership(hitPart)
    end

    for _, obj in ipairs(bomb:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                obj.CanCollide = false
                obj.Anchored = false
            end)
        end
    end

    local bv, bg, bav = MakeMissileBodyMovers(mainPart)

    local startPos = mainPart.Position
    local targetPos0, _ = GetTargetPos(targetPlayer)
    if not targetPos0 then
        pcall(function() bv:Destroy() bg:Destroy() bav:Destroy() end)
        return
    end

    local ascendTarget = Vector3.new(startPos.X, startPos.Y + MISSILE_ASCEND_HEIGHT, startPos.Z)

    local spinDir = (index % 2 == 0) and 1 or -1
    local spinSpeed = 25 * spinDir * (index / math.max(total, 1))
    bav.AngularVelocity = Vector3.new(0, spinSpeed, 0)

    local state = {
        phase      = MISSILE_STATE.PHASE_ASCEND,
        ascendPos  = ascendTarget,
        spin       = spinSpeed,
        exploded   = false,
        target     = targetPlayer,
        index      = index,
        total      = total,
        cruiseStartTime = 0,
    }

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not MissileModeActive then
            conn:Disconnect()
            return
        end
        if not bomb or not bomb.Parent then
            conn:Disconnect()
            return
        end
        if not mainPart or not mainPart.Parent then
            conn:Disconnect()
            return
        end

        local tPos, tHRP = GetTargetPos(targetPlayer)
        if not tPos then
            tPos = state.ascendPos + Vector3.new(0, 0, -1)
        end

        local currentPos = mainPart.Position

        if state.phase == MISSILE_STATE.PHASE_ASCEND then
            local toAscend = state.ascendPos - currentPos
            if toAscend.Magnitude < 15 then
                state.phase = MISSILE_STATE.PHASE_CRUISE
                state.cruiseStartTime = tick()
            else
                bv.Velocity = toAscend.Unit * MISSILE_ASCEND_SPEED
                bg.CFrame = CFrame.new(currentPos, currentPos + toAscend.Unit)
            end
        elseif state.phase == MISSILE_STATE.PHASE_CRUISE then
            local toTarget = tPos - currentPos
            local dist = toTarget.Magnitude

            if dist < 150 then
                state.phase = MISSILE_STATE.PHASE_DIVE
            else
                local desiredDir = ComputeDodgeDirection(mainPart, tPos, state.index, state.total)
                local desiredVel = desiredDir * MISSILE_CRUISE_SPEED

                bv.Velocity = bv.Velocity:Lerp(desiredVel, math.clamp(dt * MISSILE_TURN_SPEED, 0, 1))

                local lookCF
                if bv.Velocity.Magnitude > 0.01 then
                    lookCF = CFrame.new(currentPos, currentPos + bv.Velocity.Unit)
                else
                    lookCF = CFrame.new(currentPos, currentPos + desiredDir)
                end

                local rollAngle = tick() * state.spin
                lookCF = lookCF * CFrame.Angles(0, 0, rollAngle)
                bg.CFrame = lookCF
            end
                 elseif state.phase == MISSILE_STATE.PHASE_DIVE then
            local toTarget = tPos - currentPos
            local dist = toTarget.Magnitude

            if dist > 0.01 then
                local dir = toTarget.Unit
                bv.Velocity = dir * MISSILE_DIVE_SPEED

                bav.AngularVelocity = Vector3.zero

                bg.CFrame = CFrame.new(currentPos, currentPos + dir)
            end

            if dist < 5 and not state.exploded then
                state.exploded = true
                local hitbox = bomb:FindFirstChild(HitboxNames[bomb.Name])
                if hitbox then
                    pcall(function()
                        BombEvents.BombExplode:FireServer({
                            Hitbox = hitbox,
                            PositionPart = tHRP or mainPart,
                        }, tPos)
                    end)
                end
                conn:Disconnect()
            end
        end
    end)

    table.insert(MissileConnections, conn)
end

    function SpawnAndTrackMissiles(targetPlayer)
    if not targetPlayer then return end

    task.spawn(function()
        while MissileModeActive and AutoExplosionEnabled do
            if not _expTarget then break end

            local currentTarget = ExpGetPlayerByName(_expTarget)
            if not currentTarget or not currentTarget.Character then break end

            local count = math.max(ExplosionAmount or 1, 1)
            local spawnCF = CFrame.new(0, 999999, 0)

            for i = 1, count do
                local char = GetPlayerCharacterLocal()
                if char and char:FindFirstChild('HumanoidRootPart') then
                    local pos = char.HumanoidRootPart.Position + Vector3.new(0, 20, 0)
                    spawnCF = CFrame.new(pos)
                end

                                pcall(function()
                    SpawnToyRF:InvokeServer(ExplosionType, spawnCF, Vector3.new(0, 0, 0))
                    BuyToy:InvokeServer(ExplosionType)
                end)
                task.wait(0.01)
            end

            task.wait(0.05)

            local bombs = GetAllBombs()
            local startIdx = math.max(1, #bombs - count + 1)

            local total = #bombs - startIdx + 1
            local idx = 1
            for i = startIdx, #bombs do
                local bomb = bombs[i]
                if bomb and bomb.PrimaryPart then
                    task.spawn(function()
                        StartMissileMode(bomb, currentTarget, idx, total)
                    end)
                    idx = idx + 1
                end
            end

            task.wait(SpawnSpeed + 0.3)
        end
    end)
end

function AutoExplosionLoop()
    while AutoExplosionEnabled do
        local targetHRP, targetPlayer = ExpGetTargetHRP()

        if not targetPlayer then
            AutoExplosionEnabled = false
            if Toggles.AutoExplosionToggle then
                Toggles.AutoExplosionToggle:SetValue(false)
            end
            StopMissileMode()
            break
        end

        if not targetHRP then
            task.wait(0.2)
            continue
        end

        if ExplosionMode == 'TP' then
            DeleteAllBombs()
            task.wait(0.1)

            while #GetAllBombs() < ExplosionAmount and AutoExplosionEnabled do
                task.spawn(SpawNoneBomb)
                task.wait(SpawnSpeed)
                task.wait(0.02)
            end

            task.wait(0.15)

            for _, bomb in pairs(GetAllBombs()) do
                if not AutoExplosionEnabled then break end
                task.spawn(function()
                    SetupBomb(bomb)
                end)
                task.wait(SetupSpeed)
            end

            task.wait(0.2)

            targetHRP, targetPlayer = ExpGetTargetHRP()

            if targetHRP and targetPlayer then
                for _, bomb in pairs(GetAllBombs()) do
                    if not AutoExplosionEnabled then break end
                    task.spawn(function()
                        ExplodeBomb(bomb, targetHRP)
                    end)
                    task.wait(0.01)
                end
            end

            task.wait(0.15)
            DeleteAllBombs()
                elseif ExplosionMode == 'Missile' then
            DeleteAllBombs()
            StopMissileMode()
            task.wait(0.1)

            MissileModeActive = true

            SpawnAndTrackMissiles(targetPlayer)

            while AutoExplosionEnabled and MissileModeActive do
                task.wait(0.5)

                if not _expTarget then
                    break
                end

                local curTarget = ExpGetPlayerByName(_expTarget)
                if not curTarget or not curTarget.Character then
                    break
                end
            end

            StopMissileMode()
            DeleteAllBombs()
        end

        task.wait(ExplosionInterval)
    end
    StopMissileMode()
end

