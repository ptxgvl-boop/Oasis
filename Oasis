function Fun.startAngry(char)
	Fun.stopPose()
	rootPart = char:WaitForChild("HumanoidRootPart")
	humanoid = char:WaitForChild("Humanoid")
	head = char:FindFirstChild("Head")
	if not head then return end
	Fun.RagdollRemote:FireServer(rootPart, 9999999)
	movePosition = rootPart.Position
	walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
	teleportThreshold = 8

	Fun.angryState = "angry"
	Fun.angryStateTime = 0
	Fun.angryHeadStartPos = nil
	Fun.angryHeadVelocity = nil
	Fun.activeMode = "dance"

	Fun.poseConnection = Fun.RunService.Heartbeat:Connect(function(dt)
		if not char or not char.Parent or not rootPart or not rootPart.Parent then
			Fun.stopPose()
			return
		end
		Fun.angryStateTime = Fun.angryStateTime + dt

		cameraLook = Fun.camera.CFrame.LookVector
		yawAngle = math.atan2(-cameraLook.X, -cameraLook.Z)
		actualPosition = rootPart.Position
		if (actualPosition - movePosition).Magnitude > teleportThreshold then
			movePosition = actualPosition
		end
		moveDir = humanoid.MoveDirection
		if moveDir.Magnitude > 0.01 then
			movePosition = movePosition + moveDir * walkSpeed * dt
		end
		targetCFrame = CFrame.new(movePosition) * CFrame.Angles(0, yawAngle, 0)
		rootPart.CFrame = targetCFrame

		if Fun.angryState == "angry" and Fun.angryStateTime >= 3.0 then
			Fun.angryState = "launch"
			Fun.angryStateTime = 0
			if head then
				Fun.angryHeadStartPos = head.Position
				Fun.angryHeadVelocity = Vector3.new(0, 600, 0)
			end
		elseif Fun.angryState == "launch" and Fun.angryStateTime >= 1.5 then
			Fun.angryState = "shock"
			Fun.angryStateTime = 0
		elseif Fun.angryState == "shock" and Fun.angryStateTime >= 1.0 then
			Fun.angryState = "falling"
			Fun.angryStateTime = 0
		elseif Fun.angryState == "falling" and Fun.angryStateTime >= 1.5 then
			Fun.angryState = "catch"
			Fun.angryStateTime = 0
		elseif Fun.angryState == "catch" and Fun.angryStateTime >= 0.5 then
			Fun.angryState = "angry"
			Fun.angryStateTime = 0
			Fun.angryHeadStartPos = nil
			Fun.angryHeadVelocity = nil
		end

		torsoOffset, headOffset = nil, nil
		leftArmOffset, rightArmOffset = nil, nil
		leftLegOffset, rightLegOffset = nil, nil

		if Fun.angryState == "angry" then
			shakeX = math.sin(Fun.angryStateTime * 30) * 0.06
			shakeY = math.sin(Fun.angryStateTime * 35 + 1) * 0.05
			shakeZ = math.sin(Fun.angryStateTime * 28 + 2) * 0.05

			torsoOffset = CFrame.new(shakeX, shakeY, shakeZ) * CFrame.Angles(math.rad(shakeX * 20), math.rad(shakeZ * 20), math.rad(shakeY * 15))
			headOffset = CFrame.new(shakeX * 1.2, 1.5 + shakeY * 1.2, shakeZ * 1.2) * CFrame.Angles(math.rad(-5 + shakeX * 30), math.rad(shakeZ * 25), math.rad(shakeY * 20))
			leftArmOffset = CFrame.new(-2.0, 1, -1.5 + shakeZ) * CFrame.Angles(math.rad(10 + shakeX * 15), 0, math.rad(15 + shakeY * 20)) * CFrame.new(0, -1, 0)
			rightArmOffset = CFrame.new(2.0, 1, -1.5 + shakeZ) * CFrame.Angles(math.rad(10 + shakeX * 15), 0, math.rad(-15 - shakeY * 20)) * CFrame.new(0, -1, 0)
			leftLegOffset = CFrame.new(-0.9 + shakeX * 0.5, -2 + shakeY * 0.3, shakeZ * 0.3) * CFrame.Angles(math.rad(shakeX * 8), math.rad(-15), 0)
			rightLegOffset = CFrame.new(0.9 + shakeX * 0.5, -2 + shakeY * 0.3, -shakeZ * 0.3) * CFrame.Angles(math.rad(shakeX * 8), math.rad(15), 0)

		elseif Fun.angryState == "launch" then
			angryT = Fun.angryStateTime
			gravity = Vector3.new(0, -workspace.Gravity, 0)
			torsoOffset = CFrame.new(0, 0, 0)
			if head and Fun.angryHeadStartPos then
				headPos = Fun.angryHeadStartPos + Fun.angryHeadVelocity * angryT + 0.5 * gravity * angryT * angryT
				head.CFrame = CFrame.new(headPos) * CFrame.Angles(angryT * 10, angryT * 8, angryT * 12)
				head.AssemblyLinearVelocity = Vector3.zero
			end
			leftArmOffset = CFrame.new(-1.5, 1, -1.5) * CFrame.Angles(math.rad(-90), 0, math.rad(15)) * CFrame.new(0, -1, 0)
			rightArmOffset = CFrame.new(1.5, 1, -1.5) * CFrame.Angles(math.rad(-90), 0, math.rad(-15)) * CFrame.new(0, -1, 0)
			leftLegOffset = CFrame.new(-0.5, -2, 0)
			rightLegOffset = CFrame.new(0.5, -2, 0)

		elseif Fun.angryState == "shock" then
			shockIntensity = math.min(Fun.angryStateTime * 4, 1)
			torsoOffset = CFrame.new(0, shockIntensity * 0.2, -shockIntensity * 0.3) * CFrame.Angles(math.rad(-shockIntensity * 20), 0, 0)
			leftArmOffset = CFrame.new(-1.5, 1 + shockIntensity * 1.2, -1.5) * CFrame.Angles(math.rad(-90 - shockIntensity * 80), 0, math.rad(30)) * CFrame.new(0, -1, 0)
			rightArmOffset = CFrame.new(1.5, 1 + shockIntensity * 1.2, -1.5) * CFrame.Angles(math.rad(-90 - shockIntensity * 80), 0, math.rad(-30)) * CFrame.new(0, -1, 0)
			leftLegOffset = CFrame.new(-0.6, -2, 0.1) * CFrame.Angles(math.rad(-5), math.rad(15), 0)
			rightLegOffset = CFrame.new(0.6, -2, -0.1) * CFrame.Angles(math.rad(-5), math.rad(-15), 0)

		elseif Fun.angryState == "falling" then
			angryT = Fun.angryStateTime
			torsoOffset = CFrame.new(0, -0.3, 0) * CFrame.Angles(math.rad(15), 0, 0)
			if head then
				fallHeight = 150 - (angryT / 1.5) * 150
				fallHeight = math.max(fallHeight, 1.5)
				headWorldPos = (targetCFrame * CFrame.new(0, fallHeight, 0)).Position
				head.CFrame = CFrame.new(headWorldPos) * CFrame.Angles(angryT * 20, angryT * 15, angryT * 18)
				head.AssemblyLinearVelocity = Vector3.zero
			end
			leftArmOffset = CFrame.new(-1.5, 1.5, -1.5) * CFrame.Angles(math.rad(-130), 0, math.rad(20)) * CFrame.new(0, -1, 0)
			rightArmOffset = CFrame.new(1.5, 1.5, -1.5) * CFrame.Angles(math.rad(-130), 0, math.rad(-20)) * CFrame.new(0, -1, 0)
			leftLegOffset = CFrame.new(-0.6, -2, 0.2)
			rightLegOffset = CFrame.new(0.6, -2, -0.2) * CFrame.Angles(0, math.rad(20), 0)

		elseif Fun.angryState == "catch" then
			smooth = Fun.angryStateTime / 0.5
			torsoOffset = CFrame.new(0, -0.1 * (1 - smooth), 0) * CFrame.Angles(math.rad(5 * (1 - smooth)), 0, 0)
			if head then
				targetHeadCFrame = targetCFrame * CFrame.new(0, 1.5, 0)
				head.CFrame = head.CFrame:Lerp(targetHeadCFrame, smooth)
				head.AssemblyLinearVelocity = Vector3.zero
			end
			leftArmOffset = CFrame.new(-1, 1, -1.5) * CFrame.Angles(math.rad(-100), math.rad(-20), math.rad(40)) * CFrame.new(0, -0.8, 0)
			rightArmOffset = CFrame.new(1, 1, -1.5) * CFrame.Angles(math.rad(-100), math.rad(20), math.rad(-40)) * CFrame.new(0, -0.8, 0)
			leftLegOffset = CFrame.new(-0.5, -2, 0)
			rightLegOffset = CFrame.new(0.5, -2, 0)
		end

		offsets = {}
		if torsoOffset then offsets["Torso"] = torsoOffset end
		if headOffset then offsets["Head"] = headOffset end
		if leftArmOffset then offsets["Left Arm"] = leftArmOffset end
		if rightArmOffset then offsets["Right Arm"] = rightArmOffset end
		if leftLegOffset then offsets["Left Leg"] = leftLegOffset end
		if rightLegOffset then offsets["Right Leg"] = rightLegOffset end

		for partName, offsetCFrame in pairs(offsets) do
			part = char:FindFirstChild(partName)
			if part and part:IsA("BasePart") then
				part.CFrame = targetCFrame * offsetCFrame
				part.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
end

